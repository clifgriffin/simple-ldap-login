#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Yhdistä WordPress-tilit Active Directoryyn tai OpenLDAP:iin."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Accounts.php:205
msgid "Your directory account is suspended. Contact your site administrator."
msgstr "Hakemistotilisi on estetty. Ota yhteyttä sivuston ylläpitäjään."

#: pro/src/Accounts.php:249
msgid "The directory identity has changed. Contact your site administrator."
msgstr "Hakemistoidentiteetti on muuttunut. Ota yhteyttä sivuston ylläpitäjään."

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Käyttäjätiedot"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Yksi kirjautuminen"

#: pro/src/Admin.php:59
msgid "Accounts"
msgstr "Tilit"

#: pro/src/Admin.php:60
msgid "Audit"
msgstr "Tapahtumaloki"

#: pro/src/Admin.php:70
msgid "Profile updates"
msgstr "Profiilipäivitykset"

#: pro/src/Admin.php:70
msgid ""
"Copy standard LDAP profile fields to existing WordPress accounts at login. "
"Recovery accounts and super administrators are excluded."
msgstr ""
"Kopioi LDAP-hakemiston vakioprofiilikentät olemassa oleville "
"WordPress-tileille kirjautumisen yhteydessä. Palautustilit ja "
"superylläpitäjät jätetään pois."

#: pro/src/Admin.php:71
msgid "Update profiles at login"
msgstr "Päivitä profiilit kirjautumisen yhteydessä"

#: pro/src/Admin.php:71
msgid ""
"Replace names, email, and website with directory values. Empty directory "
"values clear the field. A missing or invalid email stops the update."
msgstr ""
"Korvaa nimet, sähköpostiosoite ja verkkosivusto hakemiston arvoilla. Tyhjät "
"hakemistoarvot tyhjentävät kentän. Puuttuva tai virheellinen "
"sähköpostiosoite pysäyttää päivityksen."

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Mukautetut käyttäjäkentät"

#: pro/src/Admin.php:60
msgid ""
"Copy LDAP fields, such as phone number or department, to WordPress at "
"login. Your theme or other plugins can use these values."
msgstr ""
"Kopioi LDAP-kentät, kuten puhelinnumero tai osasto, WordPressiin "
"kirjautumisen yhteydessä. Teemasi tai muut lisäosat voivat käyttää näitä "
"arvoja."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Kenttäkartoitukset"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"Yksi kartoitus per rivi: LDAP-attribuutti:WordPress-metaavain:tyyppi. "
"Esimerkki: %1$s. Tyypit: %2$s tai %3$s."

#: pro/src/Admin.php:85
msgid "Group roles"
msgstr "Ryhmien roolit"

#: pro/src/Admin.php:85
msgid ""
"Set the WordPress role from LDAP groups at each login. The first matching "
"rule applies. If no rule matches, use the default role. Recovery accounts "
"and super administrators are excluded."
msgstr ""
"Määritä WordPress-rooli LDAP-ryhmien perusteella jokaisella "
"kirjautumisella. Ensimmäistä vastaavaa sääntöä käytetään. Jos mikään sääntö "
"ei vastaa, käytetään oletusroolia. Palautustilit ja superylläpitäjät "
"jätetään pois."

#: pro/src/Admin.php:86
msgid "Group-to-role rules"
msgstr "Ryhmien roolisäännöt"

#: pro/src/Admin.php:86
msgid ""
"One group:role rule per line. Example: Editors:editor. Leave blank to keep "
"current roles."
msgstr ""
"Yksi sääntö muodossa group:role riville. Esimerkki: Editors:editor. Jätä "
"tyhjäksi, jos haluat säilyttää nykyiset roolit."

#: pro/src/Admin.php:108
msgid ""
"Enterprise includes scheduled account import, scheduled access removal, and "
"multisite membership rules. Your saved settings are kept."
msgstr ""
"Enterprise sisältää ajastetun tilien tuonnin, ajastetun käyttöoikeuksien "
"poiston ja monisivuston jäsenyyssäännöt. Tallennetut asetukset säilyvät."

#: pro/src/Admin.php:108
#: pro/src/Audit.php:224
msgid "View Enterprise upgrade"
msgstr "Näytä päivitys Enterprise-pakettiin"

#: pro/src/Admin.php:113
msgid "Enterprise account settings"
msgstr "Enterprise-tiliasetukset"

#: pro/src/Admin.php:97
msgid "Multisite membership"
msgstr "Multisite-jäsenyys"

#: pro/src/Admin.php:97
msgid ""
"Assign site membership and roles from directory groups. The first matching "
"rule for each site applies. These rules replace the group role rules for "
"network activation."
msgstr ""
"Määritä sivustojäsenyydet ja roolit hakemistoryhmien perusteella. Kullekin "
"sivustolle käytetään ensimmäistä vastaavaa sääntöä. Nämä säännöt korvaavat "
"ryhmien roolisäännöt verkkoaktivoinnissa."

#: pro/src/Admin.php:98
msgid "Group-to-site rules"
msgstr "Ryhmien sivustosäännöt"

#: pro/src/Admin.php:98
msgid ""
"One group:site ID:role rule per line. Example: Editors:2:editor. On group "
"removal, restore prior membership or remove a membership created by these "
"rules. Manual role changes are kept on removal. Leave blank to stop "
"membership updates."
msgstr ""
"Yksi sääntö muodossa group:site ID:role riville. Esimerkki: "
"Editors:2:editor. Kun ryhmäjäsenyys päättyy, aiempi jäsenyys palautetaan "
"tai näiden sääntöjen luoma jäsenyys poistetaan. Manuaaliset roolimuutokset "
"säilyvät poistamisen yhteydessä. Jätä tyhjäksi, jos haluat lopettaa "
"jäsenyyspäivitykset."

#: pro/src/Admin.php:101
msgid "Scheduled account import"
msgstr "Ajastettu tilien tuonti"

#: pro/src/Admin.php:101
msgid ""
"Import directory accounts once per hour through WordPress scheduled tasks. "
"Set a search account on Connection. Site traffic or a system task must run "
"WordPress cron."
msgstr ""
"Tuo hakemistotilejä kerran tunnissa WordPressin ajastetuilla tehtävillä. "
"Määritä hakutili Yhteys-välilehdellä. Sivuston liikenteen tai "
"järjestelmätehtävän on suoritettava WordPressin cron."

#: pro/src/Admin.php:102
msgid "Enable scheduled import"
msgstr "Ota ajastettu tuonti käyttöön"

#: pro/src/Admin.php:102
msgid ""
"Create accounts without a first login. Existing local accounts are "
"excluded. No user session is created."
msgstr ""
"Luo tilejä ilman ensimmäistä kirjautumista. Olemassa olevat paikalliset "
"tilit jätetään pois. Käyttäjäistuntoa ei luoda."

#: pro/src/Admin.php:103
msgid "Import Base DN"
msgstr "Tuonnin perus-DN"

#: pro/src/Admin.php:103
msgid "Leave blank to use the connection Base DN."
msgstr "Jätä tyhjäksi, jos haluat käyttää yhteyden perus-DN:ää."

#: pro/src/Admin.php:104
msgid "Import groups"
msgstr "Tuotavat ryhmät"

#: pro/src/Admin.php:104
msgid ""
"One group per line. Import users in at least one group. Leave blank to "
"import all users below the Import Base DN. Login group restrictions also "
"apply."
msgstr ""
"Yksi ryhmä riville. Tuo käyttäjät, jotka kuuluvat vähintään yhteen "
"ryhmistä. Jätä tyhjäksi, jos haluat tuoda kaikki tuonnin perus-DN:n alaiset "
"käyttäjät. Myös kirjautumisen ryhmärajoitukset ovat voimassa."

#: pro/src/Admin.php:106
msgid "Scheduled access removal"
msgstr "Ajastettu käyttöoikeuksien poisto"

#: pro/src/Admin.php:106
msgid ""
"Check managed directory accounts once per hour. A confirmed missing "
"account, disabled AD account, changed directory identity, or failed login "
"group rule suspends access and ends all WordPress sessions. Connection "
"errors keep the current access state."
msgstr ""
"Tarkista hallitut hakemistotilit kerran tunnissa. Vahvistettu puuttuva "
"tili, käytöstä poistettu AD-tili, muuttunut hakemistoidentiteetti tai "
"kirjautumisryhmän säännön hylkäys estää käytön ja päättää kaikki "
"WordPress-istunnot. Yhteysvirheet säilyttävät nykyisen käyttöoikeustilan."

#: pro/src/Admin.php:107
msgid "Enable scheduled access removal"
msgstr "Ota ajastettu käyttöoikeuksien poisto käyttöön"

#: pro/src/Admin.php:107
msgid ""
"Keep user data and content. Restore access after a later successful "
"directory check. Recovery accounts and super administrators are excluded. "
"Existing suspensions remain if the task or license stops."
msgstr ""
"Säilytä käyttäjätiedot ja sisältö. Palauta käyttöoikeus myöhemmän "
"onnistuneen hakemistotarkistuksen jälkeen. Palautustilit ja "
"superylläpitäjät jätetään pois. Olemassa olevat estot säilyvät, jos tehtävä "
"pysähtyy tai lisenssi ei ole enää aktiivinen."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Mukautetun kentän tallennus"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr "Jätä oletukset, ellei integraatiosi käytä erilaisia käyttäjämeta-avain."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "LDAP-arvon suffiksi"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Tallentaa LDAP-arvon, kuten phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "WordPress-arvon suffiksi"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Tallentaa muokattavan WordPress-arvon, kuten phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Yksi kirjautuminen (SSO)"

#: pro/src/Admin.php:84
msgid "Sign users in to WordPress after your web server authenticates them."
msgstr ""
"Kirjaa käyttäjät WordPressiin sen jälkeen, kun verkkopalvelimesi on "
"todennut heidät."

#: pro/src/Admin.php:85
msgid "Enable single sign-on"
msgstr "Ota käyttöön kertakirjautuminen"

#: pro/src/Admin.php:85
msgid "Users do not need a second login for WordPress."
msgstr "Käyttäjien ei tarvitse toista kirjautumista WordPressiin."

#: pro/src/Admin.php:87
msgid ""
"Configure your web server to authenticate users and set REMOTE_USER. Enter "
"an LDAP search account on Connection."
msgstr ""
"Määritä verkkopalvelimesi todennamaan käyttäjät ja asettamaan REMOTE_USER. "
"Syötä LDAP-haku tili Yhteys-välilehdelle."

#: pro/src/Admin.php:88
msgid ""
"Do not copy browser headers into REMOTE_USER. Block access that bypasses "
"web server authentication."
msgstr ""
"Älä kopioi selaimen otsikoita REMOTE_USER:iin. Estä pääsy, joka kiertää "
"verkkopalvelimen todennuksen."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Web-palvelimen autentikointi"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER on läsnä."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER puuttuu. Tarkista web-palvelimen asetukset."

#: pro/src/Audit.php:224
msgid ""
"An Enterprise license is required to collect, read, or export audit "
"history. Existing records are kept."
msgstr ""
"Tapahtumahistorian keräämiseen, lukemiseen tai vientiin tarvitaan "
"Enterprise-lisenssi. Nykyiset tietueet säilyvät."

#: pro/src/Audit.php:229
msgid "Enterprise audit settings"
msgstr "Enterprise-tapahtumalokin asetukset"

#: pro/src/Audit.php:211
msgid "Audit history"
msgstr "Tapahtumahistoria"

#: pro/src/Audit.php:211
msgid ""
"Record login results and account changes. Records contain event names and "
"account IDs. Passwords, directory field values, and credentials are "
"excluded."
msgstr ""
"Tallenna kirjautumistulokset ja tilimuutokset. Tietueet sisältävät "
"tapahtumien nimet ja tilien tunnukset. Salasanoja, hakemistokenttien arvoja "
"ja tunnistetietoja ei tallenneta."

#: pro/src/Audit.php:212
msgid "Enable audit history"
msgstr "Ota tapahtumahistoria käyttöön"

#: pro/src/Audit.php:212
msgid ""
"Store private WordPress records. Collection is off by default. Existing "
"records remain when collection stops."
msgstr ""
"Tallenna yksityisiä WordPress-tietueita. Keruu on oletusarvoisesti poissa "
"käytöstä. Olemassa olevat tietueet säilyvät keruun loputtua."

#: pro/src/Audit.php:213
msgid "Retention (days)"
msgstr "Säilytysaika (päivää)"

#: pro/src/Audit.php:213
msgid ""
"Default: 30. Range: 1 to 3650. A daily task removes older records while "
"collection is enabled."
msgstr ""
"Oletus: 30. Alue: 1–3650. Päivittäinen tehtävä poistaa vanhemmat tietueet "
"keruun ollessa käytössä."

#: pro/src/Audit.php:229
msgid "Export CSV"
msgstr "Vie CSV"

#: pro/src/Audit.php:230
msgid ""
"Latest 50 records. The export includes all retained records in this scope. "
"Times use UTC."
msgstr ""
"Viimeiset 50 tietuetta. Vienti sisältää kaikki tämän laajuuden säilytetyt "
"tietueet. Ajat ovat UTC-aikaa."

#: pro/src/Audit.php:231
msgid "Time (UTC)"
msgstr "Aika (UTC)"

#: pro/src/Audit.php:231
msgid "Event"
msgstr "Tapahtuma"

#: pro/src/Audit.php:231
msgid "Actor ID"
msgstr "Toimijan ID"

#: pro/src/Audit.php:231
msgid "User ID"
msgstr "Käyttäjän ID"

#: pro/src/Audit.php:231
msgid "Site ID"
msgstr "Sivuston ID"

#: pro/src/Audit.php:253
msgid "You do not have permission to export these records."
msgstr "Sinulla ei ole oikeutta viedä näitä tietueita."

#: pro/src/Settings_Rules.php:53
msgid ""
"Activate an Enterprise license to change these settings. Your saved "
"settings are kept."
msgstr ""
"Aktivoi Enterprise-lisenssi, jos haluat muuttaa näitä asetuksia. "
"Tallennetut asetukset säilyvät."

#: pro/src/Settings_Rules.php:130
msgid "A Pro setting is not valid. Check the format and role names."
msgstr "Pro-asetus ei ole kelvollinen. Tarkista muoto ja roolien nimet."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"Päivitys keskeytettiin. Aktivoi Simple LDAP Login Pro palauttaaksesi "
"LDAP-kirjautumisen."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Päivitys estetty: Tämä paketti ei sisällä kaikkia Pro-tiedostoja. "
"Asentaaksesi Free, deaktivoi ensin lisäosa. Asennetut tiedostosi ja "
"asetuksesi pysyvät muuttumattomina."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress ei voinut aktivoida laajennusta uudelleen."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login tarvitsee PHP 8.1 tai uudemman."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr ""
"Laajennustiedostot puuttuvat. Asenna Simple LDAP Login uudelleen julkaisun "
"ZIP-tiedostosta."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "Sinulla ei ole oikeuksia muuttaa näitä asetuksia."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "Asetusten laajuus on muuttunut. Avaa asetussivu ja yritä uudelleen."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "Sinulla ei ole oikeuksia nähdä näitä asetuksia."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Verkkosivuston asetukset"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Sivuston asetukset"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "LDAP-kirjautumisen asetukset"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr "Yhdistä LDAP:iin ja testaa kirjautuminen ennen autentikoinnin käyttöönottoa."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr ""
"LDAP-kirjautuminen ja SSO on poistettu käytöstä SLL_DISABLE_LDAP:n vuoksi "
"wp-config.php:ssa."

#: src/Admin.php:164
msgid ""
"Your saved settings use backup LDAP servers, SSO, or custom user fields. "
"Install Simple LDAP Login Pro to use these features. Your settings are kept."
msgstr ""
"Tallennetut asetuksesi käyttävät LDAP-varapalvelimia, SSO:ta tai "
"mukautettuja käyttäjäkenttiä. Asenna Simple LDAP Login Pro, jos haluat "
"käyttää näitä ominaisuuksia. Asetuksesi säilytetään."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"Tallennettua LDAP-hakusalasanaa ei voida lukea. Syötä se uudelleen "
"Yhteys-välilehdellä."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP puuttuu. Pyydä isäntääsi asentamaan se ennen LDAP-kirjautumisen "
"käyttöönottoa."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"LDAP-salasanat lähetetään ilman salausta. Käytä StartTLS:ää tai LDAPS:ää, "
"jos palvelimesi tukee sitä."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Tallenna asetukset"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "Muiden välilehtien asetukset säilytetään."

#: src/Admin.php:215
msgid ""
"Save settings before you check the connection. The check uses saved "
"settings."
msgstr ""
"Tallenna asetukset ennen yhteyden tarkistamista. Tarkistus käyttää "
"tallennettuja asetuksia."

#: src/Admin.php:219
#: src/Admin.php:391
#: src/Admin.php:393
msgid "Check Connection"
msgstr "Tarkista yhteys"

#: src/Admin.php:221
msgid "Open the Testing tab for login tests and more information."
msgstr ""
"Avaa Testaus-välilehti, jos haluat testata kirjautumista tai lukea "
"lisätietoja."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "LDAP-yhteys"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "LDAP-kirjautuminen"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Ota LDAP-todennus käyttöön."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Hakemistotyyppi"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / muu LDAP-hakemisto"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "LDAP-palvelimet"

#: src/Admin.php:242
msgid ""
"One hostname or IP address per line. An active Pro or Enterprise license "
"enables backup servers. Without an active license, only the first server is "
"used."
msgstr ""
"Yksi palvelinnimi tai IP-osoite riviä kohden. Aktiivinen Pro- tai "
"Enterprise-lisenssi mahdollistaa varapalvelinten käytön. Ilman aktiivista "
"lisenssiä käytetään vain ensimmäistä palvelinta."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Perus DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Missä etsitään käyttäjiä. Esimerkki: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Käyttäjänimen liite"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Lisätään käyttäjänimiin ilman verkkotunnusta. Esimerkki: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Windows-verkkotunnus"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr "Lyhyt verkkotunnus, kuten EXAMPLE. On etusijalla käyttäjänimen liitteen yli."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Yhteyden turvallisuus"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS vaatii luotettavan palvelintodistuksen."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (suositeltava)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "Salaamaton LDAP"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "Salaamaton LDAP vaatii oikeudet Lisäasetukset-välilehdellä."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Portti"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 StartTLS:lle; 636 LDAPS:lle."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Etsi alikansioita"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Etsi kaikki organisaatioyksiköt Perus DN:n alapuolelta."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "LDAP-hakutili"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "LDAP-tili, jolla on lukuoikeus käyttäjiin ja ryhmiin."

#: src/Admin.php:253
