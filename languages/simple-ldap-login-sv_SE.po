#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Anslut WordPress-konton till Active Directory eller OpenLDAP."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Användardata"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Enkel inloggning"

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Anpassade användarfält"

#: pro/src/Admin.php:60
msgid "Copy LDAP attributes to WordPress user meta fields."
msgstr "Kopiera LDAP-attribut till WordPress användarmetadatafält."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Fältmappningar"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"Ett mappning per rad: LDAP-attribut:WordPress meta nyckel:typ. Exempel: "
"%1$s. Typer: %2$s eller %3$s."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Lagring av anpassade fält"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr ""
"Lämna standardinställningarna om din integration inte använder andra "
"användarmetadata nycklar."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "LDAP-värdesuffix"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Lagrar LDAP-värdet, som phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "WordPress-värdesuffix"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Lagrar det redigerbara WordPress-värdet, som phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Enkel inloggning (SSO)"

#: pro/src/Admin.php:83
msgid ""
"Your web server must authenticate users and set REMOTE_USER. Never copy a "
"browser header into REMOTE_USER or allow access that bypasses server "
"authentication. Set the LDAP search account on Connection."
msgstr ""
"Din webbserver måste autentisera användare och ställa in REMOTE_USER. "
"Kopiera aldrig en webbläsarhuvud till REMOTE_USER eller tillåt åtkomst som "
"kringgår serverautentisering. Ställ in LDAP-sökkontot på Anslutning."

#: pro/src/Admin.php:84
msgid "Enable automatic login after web server authentication."
msgstr "Aktivera automatisk inloggning efter webbserverautentisering."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Webbserverautentisering"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER är närvarande."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER saknas. Kontrollera webbserverkonfigurationen."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"Uppdateringen stoppades. Aktivera Simple LDAP Login Pro för att återställa "
"LDAP-inloggning."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Uppdatering blockerad: Detta paket innehåller inte alla Pro-filer. För att "
"installera Free, inaktivera pluginet först. Dina installerade filer och "
"inställningar är oförändrade."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress kunde inte återaktivera pluginen."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login kräver PHP 8.1 eller senare."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr "Pluginfiler saknas. Installera om Simple LDAP Login från release ZIP."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "Du har inte behörighet att ändra dessa inställningar."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "Inställningsomfånget har ändrats. Öppna inställningssidan och försök igen."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "Du har inte behörighet att visa dessa inställningar."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Nätverksinställningar"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Webbplatsinställningar"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "LDAP-inloggningsinställningar"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr "Anslut till LDAP, testa sedan en inloggning innan autentisering aktiveras."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr "LDAP-inloggning och SSO är inaktiverade av SLL_DISABLE_LDAP i wp-config.php."

#: src/Admin.php:163
msgid ""
"Your saved settings use SSO or custom user fields. Install Simple LDAP "
"Login Pro to use these features. Your settings are kept."
msgstr ""
"Dina sparade inställningar använder SSO eller anpassade användarfält. "
"Installera Simple LDAP Login Pro för att använda dessa funktioner. Dina "
"inställningar sparas."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"Det sparade LDAP-sökordet kan inte läsas. Ange det igen på fliken "
"Anslutning."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP saknas. Be din värd att installera det innan LDAP-inloggning "
"aktiveras."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"LDAP-lösenord skickas utan kryptering. Använd StartTLS eller LDAPS om din "
"server stöder det."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Spara inställningar"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "Inställningar på andra flikar sparas."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "LDAP-anslutning"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "LDAP-inloggning"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Aktivera LDAP-autentisering."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Katalogtyp"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / annan LDAP-katalog"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "LDAP-servrar"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr "Ett värdnamn eller IP-adress per rad. Servrar prövas i ordning."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Bas DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Var du ska söka efter användare. Exempel: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Användarnamn suffix"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Läggs till användarnamn utan domän. Exempel: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Windows-domän"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr "Kort domännamn, som EXAMPLE. Har företräde framför användarnamn suffix."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Anslutningssäkerhet"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS kräver ett betrott servercertifikat."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (rekommenderas)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "Okrypterad LDAP"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "Okrypterad LDAP kräver tillstånd på fliken Avancerat."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Port"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 för StartTLS; 636 för LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Sök i undermappar"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Sök i alla organisatoriska enheter under Bas DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "LDAP-sökkonto"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "Ett LDAP-konto med läsbehörighet till användare och grupper."

#: src/Admin.php:253
msgid "Search account"
msgstr "Sökkonto"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "LDAP bind DN eller kontonamn."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "Lösenord för sökonto"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "Lämna tomt för att behålla det sparade lösenordet."

#: src/Admin.php:262
msgid "Login rules"
msgstr "Inloggningsregler"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Kräv LDAP-lösenord"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Blockera WordPress-lösenord utom för återställningstillgång."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Lokal återställningstillgång"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Valda administratörer"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Alla superadministratörer (legacy)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Alla administratörer (legacy)"

#: src/Admin.php:270
msgid "Off"
msgstr "Av"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr "Välj vem som kan använda ett WordPress-lösenord när LDAP-lösenord krävs."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "Automatisk kontoskapande"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "Skapa ett WordPress-konto vid första lyckade LDAP-inloggning."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "Standardroll"

#: src/Admin.php:280
msgid "For new accounts only."
msgstr "Endast för nya konton."

#: src/Admin.php:281
#: src/Settings.php:609
msgid "Required groups"
msgstr "Krävda grupper"

#: src/Admin.php:281
msgid ""
"One group name per line. Users must belong to at least one. Leave blank to "
"allow all LDAP users."
msgstr ""
"Ett gruppnamn per rad. Användare måste tillhöra minst en. Lämna tomt för "
"att tillåta alla LDAP-användare."

#: src/Admin.php:295
#: src/Settings.php:613
msgid "Recovery accounts"
msgstr "Återställningskonton"

#: src/Admin.php:305
msgid ""
"For Selected administrators only. Use separate local accounts with "
"WordPress passwords. Hold Ctrl or Command to select multiple accounts."
msgstr ""
"Endast för valda administratörer. Använd separata lokala konton med "
"WordPress-lösenord. Håll Ctrl eller Command för att välja flera konton."

#: src/Admin.php:320
msgid "Connection options"
msgstr "Anslutningsalternativ"

#: src/Admin.php:320
msgid "Change these only if the default values do not work with your directory."
msgstr "Ändra dessa endast om standardvärdena inte fungerar med din katalog."

#: src/Admin.php:321
msgid "LDAP timeout (seconds)"
msgstr "LDAP timeout (sekunder)"

#: src/Admin.php:321
msgid "Maximum wait for an LDAP operation. Default: 5 seconds."
msgstr "Maximal väntetid för en LDAP-operation. Standard: 5 sekunder."

#: src/Admin.php:322
#: src/Settings.php:606
msgid "Login attribute"
msgstr "Inloggningsattribut"

#: src/Admin.php:322
msgid "Attribute used to find users. Default: uid."
msgstr "Attribut som används för att hitta användare. Standard: uid."

#: src/Admin.php:323
msgid "Allow unencrypted LDAP"
msgstr "Tillåt okrypterad LDAP"

#: src/Admin.php:323
msgid "Allow passwords to be sent without encryption."
msgstr "Tillåt lösenord att skickas utan kryptering."

#: src/Admin.php:325
msgid "Group search"
msgstr "Gruppsökning"

#: src/Admin.php:326
#: src/Settings.php:610
msgid "Group base DN"
msgstr "Gruppbas DN"

#: src/Admin.php:326
msgid "Leave blank to use the user Base DN."
msgstr "Lämna tomt för att använda användarens bas DN."

#: src/Admin.php:327
#: src/Settings.php:607
msgid "Group name attribute"
msgstr "Gruppnamnsattribut"

#: src/Admin.php:327
msgid "Default: cn."
msgstr "Standard: cn."

#: src/Admin.php:328
#: src/Settings.php:608
msgid "Group member attribute"
msgstr "Gruppmedlemsattribut"

#: src/Admin.php:328
msgid "Default: memberUid. Use member or uniqueMember if groups store user DNs."
msgstr ""
"Standard: memberUid. Använd member eller uniqueMember om grupper lagrar "
"användar-DN:er."

#: src/Admin.php:330
msgid "Profile attributes"
msgstr "Profilattribut"

#: src/Admin.php:330
msgid "LDAP attributes copied to new WordPress accounts."
msgstr "LDAP-attribut kopieras till nya WordPress-konton."

#: src/Admin.php:331
#: src/Settings.php:618
msgid "First name attribute"
msgstr "Förnamnsattribut"

#: src/Admin.php:332
#: src/Settings.php:619
msgid "Last name attribute"
msgstr "Efternamnsattribut"

#: src/Admin.php:333
#: src/Settings.php:620
msgid "Email attribute"
msgstr "E-postattribut"

#: src/Admin.php:334
#: src/Settings.php:621
msgid "Website attribute"
msgstr "Webbplatsattribut"

#: src/Admin.php:337
msgid "Data retention"
msgstr "Dataretention"

#: src/Admin.php:338
msgid "Delete settings when removing the plugin"
msgstr "Ta bort inställningar när plugin-programmet tas bort"

#: src/Admin.php:338
msgid ""
"Delete saved settings and LDAP credentials when WordPress deletes the "
"plugin. Keep user accounts."
msgstr ""
"Ta bort sparade inställningar och LDAP-referenser när WordPress tar bort "
"plugin-programmet. Behåll användarkonton."

#: src/Admin.php:346
#: src/Admin.php:382
msgid "Test LDAP login"
msgstr "Testa LDAP-inloggning"

#: src/Admin.php:346
msgid ""
"Save your settings, then run both tests. Keep this administrator session "
"open."
msgstr ""
"Spara dina inställningar, kör sedan båda testerna. Håll denna "
"administratörssession öppen."

#: src/Admin.php:348
msgid ""
"Tests check the connection, password, and required groups. They do not "
"create accounts or sign users in."
msgstr ""
"Tester kontrollerar anslutningen, lösenordet och nödvändiga grupper. De "
"skapar inte konton eller loggar in användare."

#: src/Admin.php:349
msgid "After both tests pass, enable LDAP and try logging in from another browser."
msgstr ""
"När båda testerna har godkänts, aktivera LDAP och försök logga in från en "
"annan webbläsare."

#: src/Admin.php:350
msgid "Recovery"
msgstr "Återställning"

#: src/Admin.php:351
msgid ""
"If you are locked out, rename the simple-ldap-login folder using your "
"hosting file manager. Log in with a WordPress administrator password, then "
"restore the folder and correct the settings."
msgstr ""
"Om du är utelåst, döp om mappen simple-ldap-login med din värdtjänsts "
"filhanterare. Logga in med ett WordPress-administratörslösenord, återställ "
"sedan mappen och korrigera inställningarna."

#: src/Admin.php:352
msgid ""
"For certificate errors, ask your host to configure the trusted LDAP "
"certificate authority."
msgstr ""
"För certifikatfel, be din värd att konfigurera den betrodda "
"LDAP-certifikatmyndigheten."

#: src/Admin.php:366
msgid "LDAP tests"
msgstr "LDAP-tester"

#: src/Admin.php:367
msgid "Tests use saved settings."
msgstr "Tester använder sparade inställningar."

#: src/Admin.php:372
msgid "1. Test connection"
msgstr "1. Testa anslutning"

#: src/Admin.php:373
msgid "Connect to LDAP and test the search account, if set."
msgstr "Anslut till LDAP och testa sökkontot, om det är inställt."

#: src/Admin.php:374
msgid "Test connection"
msgstr "Testa anslutning"

#: src/Admin.php:378
msgid "2. Test login"
msgstr "2. Testa inloggning"

#: src/Admin.php:379
msgid "Check an LDAP username, password, and group membership."
msgstr "Kontrollera ett LDAP-användarnamn, lösenord och gruppmedlemskap."

#: src/Admin.php:380
msgid "LDAP username"
msgstr "LDAP-användarnamn"

#: src/Admin.php:381
msgid "LDAP password"
msgstr "LDAP-lösenord"

#: src/Admin.php:537
msgid "Settings saved."
msgstr "Inställningar sparade."

#: src/Admin.php:538
msgid "Connection test passed."
msgstr "Anslutningstest godkänt."

#: src/Admin.php:539
msgid ""
"Cannot connect to LDAP. Check the server, port, TLS certificate, and search "
"account."
msgstr ""
"Kan inte ansluta till LDAP. Kontrollera servern, porten, TLS-certifikatet "
"och sökkontot."

#: src/Admin.php:540
msgid "LDAP login test passed. No account was created."
msgstr "LDAP-inloggningstest godkänt. Inget konto skapades."

#: src/Admin.php:541
msgid "LDAP login test failed. Check the username, password, and required groups."
msgstr ""
"LDAP-inloggningstest misslyckades. Kontrollera användarnamn, lösenord och "
"nödvändiga grupper."

#: src/Admin.php:542
msgid "Could not save settings. Check the values and try again."
msgstr "Kunde inte spara inställningar. Kontrollera värdena och försök igen."

#: src/Admin.php:586
msgid "Connection"
msgstr "Anslutning"

#: src/Admin.php:587
msgid "Access"
msgstr "Åtkomst"

#: src/Admin.php:588
msgid "Advanced"
msgstr "Avancerat"

#: src/Admin.php:589
msgid "Troubleshooting"
msgstr "Felsökning"

#: src/Authenticator.php:151
msgid ""
"Your LDAP login is valid, but you need a WordPress account. Contact your "
"site administrator."
msgstr ""
"Din LDAP-inloggning är giltig, men du behöver ett WordPress-konto. Kontakta "
"din webbplatsadministratör."

#: src/Authenticator.php:154
msgid ""
"Your LDAP username is not a valid WordPress username. Contact your site "
"administrator."
msgstr ""
"Ditt LDAP-användarnamn är inte ett giltigt WordPress-användarnamn. Kontakta "
"din webbplatsadministratör."

#: src/Authenticator.php:158
msgid ""
"The default WordPress role is not available. Contact your site "
"administrator."
msgstr ""
"Den standard WordPress-roll är inte tillgänglig. Kontakta din "
"webbplatsadministratör."

#: src/Authenticator.php:175
msgid "Could not create your WordPress account. Contact your site administrator."
msgstr "Kunde inte skapa ditt WordPress-konto. Kontakta din webbplatsadministratör."

#: src/Authenticator.php:180
msgid "Use your WordPress password for this recovery account."
msgstr "Använd ditt WordPress-lösenord för detta återställningskonto."

#: src/Ldap_Client.php:440
msgid ""
"LDAP login failed. Check your username and password or contact your site "
"administrator."
msgstr ""
"LDAP-inloggning misslyckades. Kontrollera ditt användarnamn och lösenord "
"eller kontakta din webbplatsadministratör."

#: src/Ldap_Client.php:442
msgid "Your account is not allowed to log in to this site."
msgstr "Ditt konto har inte behörighet att logga in på denna webbplats."

#: src/Ldap_Client.php:444
msgid "LDAP login is unavailable. Contact your site administrator."
msgstr "LDAP-inloggning är inte tillgänglig. Kontakta din webbplatsadministratör."

#: src/Secrets.php:24
msgid "PHP OpenSSL is required to save the LDAP search password."
msgstr "PHP OpenSSL krävs för att spara LDAP-sökpasswordet."

#: src/Secrets.php:92
msgid ""
"Could not read or save the LDAP search password. Enter it again. If this "
"continues, ask your host to check OpenSSL and the encryption key."
msgstr ""
"Kunde inte läsa eller spara LDAP-sökpasswordet. Ange det igen. Om detta "
"fortsätter, be din värd att kontrollera OpenSSL och krypteringsnyckeln."

#: src/Settings.php:310
msgid ""
"Select a recovery account on the Access tab, or turn local recovery access "
"Off."
msgstr ""
"Välj ett återställningskonto på Åtkomst-fliken, eller stäng av lokal "
"återställningsåtkomst."

#: src/Settings.php:318
msgid ""
"Enable Allow unencrypted LDAP on the Advanced tab, or choose StartTLS or "
"LDAPS."
msgstr ""
"Aktivera Tillåt okrypterad LDAP på Avancerat-fliken, eller välj StartTLS "
"eller LDAPS."

#: src/Settings.php:341
msgid "A custom field mapping uses a protected or invalid WordPress user meta key."
msgstr ""
"En anpassad fältmappning använder en skyddad eller ogiltig WordPress "
"användarmeta-nyckel."

#: src/Settings.php:346
msgid "Enter a Base DN and at least one LDAP server before enabling LDAP login."
msgstr "Ange en Bas DN och minst en LDAP-server innan du aktiverar LDAP-inloggning."

#: src/Settings.php:349
msgid "WordPress could not save the settings. Try again."
msgstr "WordPress kunde inte spara inställningarna. Försök igen."

#: src/Settings.php:604
msgid "LDAP protocol version"
msgstr "LDAP-protokollversion"

#: src/Settings.php:605
msgid "LDAP timeout"
msgstr "LDAP-tidsgräns"

#: src/Settings.php:623
msgid "Check the submitted settings. No changes were saved."
