#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Forbind WordPress-konti til Active Directory eller OpenLDAP."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Brugerdata"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Single sign-on"

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Brugerdefinerede felter"

#: pro/src/Admin.php:60
msgid "Copy LDAP attributes to WordPress user meta fields."
msgstr "Kopier LDAP-attributter til WordPress bruger meta felter."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Feltkortlægninger"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"Én mapping pr. linje: LDAP-attribut:WordPress meta nøgle:type. Eksempel: "
"%1$s. Typer: %2$s eller %3$s."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Lagring af brugerdefinerede felter"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr ""
"Lad standardindstillingerne være, medmindre din integration bruger "
"forskellige bruger meta nøgler."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "LDAP værdi suffix"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Lagrer LDAP-værdien, såsom phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "WordPress værdi suffix"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Lagrer den redigerbare WordPress-værdi, såsom phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Single sign-on (SSO)"

#: pro/src/Admin.php:83
msgid ""
"Your web server must authenticate users and set REMOTE_USER. Never copy a "
"browser header into REMOTE_USER or allow access that bypasses server "
"authentication. Set the LDAP search account on Connection."
msgstr ""
"Din webserver skal autentificere brugere og sætte REMOTE_USER. Kopier "
"aldrig en browserheader ind i REMOTE_USER eller tillad adgang, der omgår "
"serverautentificering. Sæt LDAP-søgekontoen under Forbindelse."

#: pro/src/Admin.php:84
msgid "Enable automatic login after web server authentication."
msgstr "Aktivér automatisk login efter webserverautentificering."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Webserverautentificering"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER er til stede."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER mangler. Tjek webserverkonfigurationen."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"Opdateringen blev stoppet. Aktiver Simple LDAP Login Pro for at gendanne "
"LDAP-login."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Opdatering blokeret: Denne pakke inkluderer ikke alle Pro-filer. For at "
"installere Free, deaktiver plugin'et først. Dine installerede filer og "
"indstillinger er uændrede."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress kunne ikke genaktivere plugin."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login kræver PHP 8.1 eller nyere."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr "Plugin-filer mangler. Geninstaller Simple LDAP Login fra release ZIP."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "Du har ikke tilladelse til at ændre disse indstillinger."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "Indstillingsomfanget er ændret. Åbn indstillingssiden og prøv igen."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "Du har ikke tilladelse til at se disse indstillinger."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Netværksindstillinger"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Siteindstillinger"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "LDAP-loginindstillinger"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr ""
"Forbind til LDAP, og test derefter et login, før du aktiverer "
"autentificering."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr "LDAP-login og SSO er deaktiveret af SLL_DISABLE_LDAP i wp-config.php."

#: src/Admin.php:163
msgid ""
"Your saved settings use SSO or custom user fields. Install Simple LDAP "
"Login Pro to use these features. Your settings are kept."
msgstr ""
"Dine gemte indstillinger bruger SSO eller brugerdefinerede felter. "
"Installer Simple LDAP Login Pro for at bruge disse funktioner. Dine "
"indstillinger bevares."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"Den gemte LDAP-søgeadgangskode kan ikke læses. Indtast den igen på fanen "
"Forbindelse."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP mangler. Bed din host om at installere det, før LDAP-login "
"aktiveres."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"LDAP-adgangskoder sendes uden kryptering. Brug StartTLS eller LDAPS, hvis "
"din server understøtter det."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Gem indstillinger"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "Indstillinger på andre faner bevares."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "LDAP-forbindelse"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "LDAP-login"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Aktiver LDAP-godkendelse."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Katalogtype"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / andet LDAP-katalog"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "LDAP-servere"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr "Én vært eller IP-adresse pr. linje. Servere prøves i rækkefølge."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Base DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Hvor der skal søges efter brugere. Eksempel: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Brugernavnssuffix"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Tilføjet til brugernavne uden domæne. Eksempel: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Windows-domæne"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr "Kort domænenavn, såsom EXAMPLE. Har prioritet over brugernavnssuffixet."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Forbindelsessikkerhed"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS kræver et betroet servercertifikat."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (anbefales)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "Udkrypteret LDAP"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "Udkrypteret LDAP kræver tilladelse på fanen Avanceret."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Port"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 for StartTLS; 636 for LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Søg i undermapper"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Søg i alle organisatoriske enheder under Base DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "LDAP-søgekonto"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "En LDAP-konto med læseadgang til brugere og grupper."

#: src/Admin.php:253
msgid "Search account"
msgstr "Søgekonto"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "LDAP bind DN eller kontonavn."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "Adgangskode til søgekonto"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "Lad være blank for at bevare den gemte adgangskode."

#: src/Admin.php:262
msgid "Login rules"
msgstr "Loginregler"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Krav om LDAP-adgangskoder"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Bloker WordPress-adgangskoder undtagen for recovery-adgang."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Lokal recovery-adgang"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Valgte administratorer"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Alle superadministratorer (legacy)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Alle administratorer (legacy)"

#: src/Admin.php:270
msgid "Off"
msgstr "Slukket"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr ""
"Vælg, hvem der kan bruge en WordPress-adgangskode, når LDAP-adgangskoder "
"kræves."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "Automatisk kontooprettelse"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "Opret en WordPress-konto ved den første succesfulde LDAP-login."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "Standardrolle"

#: src/Admin.php:280
msgid "For new accounts only."
msgstr "Kun for nye konti."

#: src/Admin.php:281
#: src/Settings.php:609
msgid "Required groups"
msgstr "Nødvendige grupper"

#: src/Admin.php:281
msgid ""
"One group name per line. Users must belong to at least one. Leave blank to "
"allow all LDAP users."
msgstr ""
"Én gruppenavn pr. linje. Brugere skal tilhøre mindst én. Lad være blank for "
"at tillade alle LDAP-brugere."

#: src/Admin.php:295
#: src/Settings.php:613
msgid "Recovery accounts"
msgstr "Recovery-konti"

#: src/Admin.php:305
msgid ""
"For Selected administrators only. Use separate local accounts with "
"WordPress passwords. Hold Ctrl or Command to select multiple accounts."
msgstr ""
"Kun for valgte administratorer. Brug separate lokale konti med "
"WordPress-adgangskoder. Hold Ctrl eller Command for at vælge flere konti."

#: src/Admin.php:320
msgid "Connection options"
msgstr "Forbindelsesmuligheder"

#: src/Admin.php:320
msgid "Change these only if the default values do not work with your directory."
msgstr "Ændre disse kun, hvis standardværdierne ikke fungerer med dit katalog."

#: src/Admin.php:321
msgid "LDAP timeout (seconds)"
msgstr "LDAP timeout (sekunder)"

#: src/Admin.php:321
msgid "Maximum wait for an LDAP operation. Default: 5 seconds."
msgstr "Maksimal ventetid for en LDAP-operation. Standard: 5 sekunder."

#: src/Admin.php:322
#: src/Settings.php:606
msgid "Login attribute"
msgstr "Loginattribut"

#: src/Admin.php:322
msgid "Attribute used to find users. Default: uid."
msgstr "Attribut, der bruges til at finde brugere. Standard: uid."

#: src/Admin.php:323
msgid "Allow unencrypted LDAP"
msgstr "Tillad udkrypteret LDAP"

#: src/Admin.php:323
msgid "Allow passwords to be sent without encryption."
msgstr "Tillad adgangskoder at blive sendt uden kryptering."

#: src/Admin.php:325
msgid "Group search"
msgstr "Gruppe søgning"

#: src/Admin.php:326
#: src/Settings.php:610
msgid "Group base DN"
msgstr "Gruppe base DN"

#: src/Admin.php:326
msgid "Leave blank to use the user Base DN."
msgstr "Lad være tom for at bruge bruger Base DN."

#: src/Admin.php:327
#: src/Settings.php:607
msgid "Group name attribute"
msgstr "Gruppe navn attribut"

#: src/Admin.php:327
msgid "Default: cn."
msgstr "Standard: cn."

#: src/Admin.php:328
#: src/Settings.php:608
msgid "Group member attribute"
msgstr "Gruppe medlem attribut"

#: src/Admin.php:328
msgid "Default: memberUid. Use member or uniqueMember if groups store user DNs."
msgstr ""
"Standard: memberUid. Brug member eller uniqueMember, hvis grupper gemmer "
"bruger DNs."

#: src/Admin.php:330
msgid "Profile attributes"
msgstr "Profil attributter"

#: src/Admin.php:330
msgid "LDAP attributes copied to new WordPress accounts."
msgstr "LDAP attributter kopieret til nye WordPress konti."

#: src/Admin.php:331
#: src/Settings.php:618
msgid "First name attribute"
msgstr "Fornavn attribut"

#: src/Admin.php:332
#: src/Settings.php:619
msgid "Last name attribute"
msgstr "Efternavn attribut"

#: src/Admin.php:333
#: src/Settings.php:620
msgid "Email attribute"
msgstr "E-mail attribut"

#: src/Admin.php:334
#: src/Settings.php:621
msgid "Website attribute"
msgstr "Websted attribut"

#: src/Admin.php:337
msgid "Data retention"
msgstr "Dataopbevaring"

#: src/Admin.php:338
msgid "Delete settings when removing the plugin"
msgstr "Slet indstillinger ved fjernelse af plugin"

#: src/Admin.php:338
msgid ""
"Delete saved settings and LDAP credentials when WordPress deletes the "
"plugin. Keep user accounts."
msgstr ""
"Slet gemte indstillinger og LDAP legitimationsoplysninger, når WordPress "
"sletter plugin. Behold brugerkonti."

#: src/Admin.php:346
#: src/Admin.php:382
msgid "Test LDAP login"
msgstr "Test LDAP login"

#: src/Admin.php:346
msgid ""
"Save your settings, then run both tests. Keep this administrator session "
"open."
msgstr ""
"Gem dine indstillinger, og kør derefter begge tests. Hold denne "
"administrator session åben."

#: src/Admin.php:348
msgid ""
"Tests check the connection, password, and required groups. They do not "
"create accounts or sign users in."
msgstr ""
"Tests kontrollerer forbindelsen, adgangskoden og de krævede grupper. De "
"opretter ikke konti eller logger brugere ind."

#: src/Admin.php:349
msgid "After both tests pass, enable LDAP and try logging in from another browser."
msgstr ""
"Når begge tests er bestået, aktiver LDAP og prøv at logge ind fra en anden "
"browser."

#: src/Admin.php:350
msgid "Recovery"
msgstr "Gendannelse"

#: src/Admin.php:351
msgid ""
"If you are locked out, rename the simple-ldap-login folder using your "
"hosting file manager. Log in with a WordPress administrator password, then "
"restore the folder and correct the settings."
msgstr ""
"Hvis du er låst ude, skal du omdøbe mappen simple-ldap-login ved hjælp af "
"din hosting filhåndtering. Log ind med en WordPress administrator "
"adgangskode, og gendan derefter mappen og ret indstillingerne."

#: src/Admin.php:352
msgid ""
"For certificate errors, ask your host to configure the trusted LDAP "
"certificate authority."
msgstr ""
"For certifikatfejl, bed din host om at konfigurere den betroede LDAP "
"certifikatmyndighed."

#: src/Admin.php:366
msgid "LDAP tests"
msgstr "LDAP tests"

#: src/Admin.php:367
msgid "Tests use saved settings."
msgstr "Tests bruger gemte indstillinger."

#: src/Admin.php:372
msgid "1. Test connection"
msgstr "1. Test forbindelse"

#: src/Admin.php:373
msgid "Connect to LDAP and test the search account, if set."
msgstr "Forbind til LDAP og test søgekontoen, hvis den er indstillet."

#: src/Admin.php:374
msgid "Test connection"
msgstr "Test forbindelse"

#: src/Admin.php:378
msgid "2. Test login"
msgstr "2. Test login"

#: src/Admin.php:379
msgid "Check an LDAP username, password, and group membership."
msgstr "Kontroller et LDAP brugernavn, adgangskode og gruppemedlemskab."

#: src/Admin.php:380
msgid "LDAP username"
msgstr "LDAP brugernavn"

#: src/Admin.php:381
msgid "LDAP password"
msgstr "LDAP adgangskode"

#: src/Admin.php:537
msgid "Settings saved."
msgstr "Indstillinger gemt."

#: src/Admin.php:538
msgid "Connection test passed."
msgstr "Forbindelsestest bestået."

#: src/Admin.php:539
msgid ""
"Cannot connect to LDAP. Check the server, port, TLS certificate, and search "
"account."
msgstr ""
"Kan ikke oprette forbindelse til LDAP. Tjek serveren, porten, TLS "
"certifikatet og søgekontoen."

#: src/Admin.php:540
msgid "LDAP login test passed. No account was created."
msgstr "LDAP login test bestået. Ingen konto blev oprettet."

#: src/Admin.php:541
msgid "LDAP login test failed. Check the username, password, and required groups."
msgstr ""
"LDAP login test fejlede. Tjek brugernavnet, adgangskoden og de krævede "
"grupper."

#: src/Admin.php:542
msgid "Could not save settings. Check the values and try again."
msgstr "Kunne ikke gemme indstillinger. Tjek værdierne og prøv igen."

#: src/Admin.php:586
msgid "Connection"
msgstr "Forbindelse"

#: src/Admin.php:587
msgid "Access"
msgstr "Adgang"

#: src/Admin.php:588
msgid "Advanced"
msgstr "Avanceret"

#: src/Admin.php:589
msgid "Troubleshooting"
msgstr "Fejlfinding"

#: src/Authenticator.php:151
msgid ""
"Your LDAP login is valid, but you need a WordPress account. Contact your "
"site administrator."
msgstr ""
"Dit LDAP login er gyldigt, men du har brug for en WordPress konto. Kontakt "
"din webstedadministrator."

#: src/Authenticator.php:154
msgid ""
"Your LDAP username is not a valid WordPress username. Contact your site "
"administrator."
msgstr ""
"Dit LDAP brugernavn er ikke et gyldigt WordPress brugernavn. Kontakt din "
"webstedadministrator."

#: src/Authenticator.php:158
msgid ""
"The default WordPress role is not available. Contact your site "
"administrator."
msgstr ""
"Den standard WordPress rolle er ikke tilgængelig. Kontakt din "
"webstedadministrator."

#: src/Authenticator.php:175
msgid "Could not create your WordPress account. Contact your site administrator."
msgstr "Kunne ikke oprette din WordPress konto. Kontakt din webstedadministrator."

#: src/Authenticator.php:180
msgid "Use your WordPress password for this recovery account."
msgstr "Brug din WordPress adgangskode til denne gendannelseskonto."

#: src/Ldap_Client.php:440
msgid ""
"LDAP login failed. Check your username and password or contact your site "
"administrator."
msgstr ""
"LDAP login fejlede. Tjek dit brugernavn og adgangskode eller kontakt din "
"webstedadministrator."

#: src/Ldap_Client.php:442
msgid "Your account is not allowed to log in to this site."
msgstr "Din konto har ikke tilladelse til at logge ind på dette site."

#: src/Ldap_Client.php:444
msgid "LDAP login is unavailable. Contact your site administrator."
msgstr "LDAP-login er ikke tilgængeligt. Kontakt din siteadministrator."

#: src/Secrets.php:24
msgid "PHP OpenSSL is required to save the LDAP search password."
msgstr "PHP OpenSSL er påkrævet for at gemme LDAP-søgeadgangskoden."

#: src/Secrets.php:92
msgid ""
"Could not read or save the LDAP search password. Enter it again. If this "
"continues, ask your host to check OpenSSL and the encryption key."
msgstr ""
"Kunne ikke læse eller gemme LDAP-søgeadgangskoden. Indtast den igen. Hvis "
"dette fortsætter, bed din host om at tjekke OpenSSL og krypteringsnøglen."

#: src/Settings.php:310
msgid ""
"Select a recovery account on the Access tab, or turn local recovery access "
"Off."
msgstr ""
"Vælg en gendannelseskonto på Adgang-fanen, eller deaktiver lokal "
"gendannelsesadgang."

#: src/Settings.php:318
msgid ""
"Enable Allow unencrypted LDAP on the Advanced tab, or choose StartTLS or "
"LDAPS."
msgstr ""
"Aktivér Tillad ukrypteret LDAP på Avanceret-fanen, eller vælg StartTLS "
"eller LDAPS."

#: src/Settings.php:341
msgid "A custom field mapping uses a protected or invalid WordPress user meta key."
msgstr ""
"En brugerdefineret feltkortlægning bruger en beskyttet eller ugyldig "
"WordPress bruger meta-nøgle."

#: src/Settings.php:346
msgid "Enter a Base DN and at least one LDAP server before enabling LDAP login."
msgstr "Indtast en Base DN og mindst én LDAP-server, før du aktiverer LDAP-login."

#: src/Settings.php:349
msgid "WordPress could not save the settings. Try again."
msgstr "WordPress kunne ikke gemme indstillingerne. Prøv igen."

#: src/Settings.php:604
msgid "LDAP protocol version"
msgstr "LDAP-protokolversion"

#: src/Settings.php:605
msgid "LDAP timeout"
msgstr "LDAP timeout"

#: src/Settings.php:623
msgid "Check the submitted settings. No changes were saved."
msgstr "Tjek de indsendte indstillinger. Ingen ændringer blev gemt."

#: src/Settings.php:626
#. translators: %s: setting label.
#, php-format
msgid "Check %s. No changes were saved."
msgstr "Tjek %s. Ingen ændringer blev gemt."
