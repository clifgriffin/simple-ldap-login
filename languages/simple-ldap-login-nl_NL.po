#: src/Ldap_Client.php:440
msgid ""
"LDAP login failed. Check your username and password or contact your site "
"administrator."
msgstr ""
"LDAP-login mislukt. Controleer uw gebruikersnaam en wachtwoord of neem "
"contact op met uw sitebeheerder."

