#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Propojte účty WordPress s Active Directory nebo OpenLDAP."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Uživatelská data"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Jednotné přihlášení"

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Vlastní uživatelská pole"

#: pro/src/Admin.php:60
msgid "Copy LDAP attributes to WordPress user meta fields."
msgstr "Kopírujte atributy LDAP do meta polí uživatelů WordPress."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Mapování polí"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"Jedno mapování na řádek: LDAP atribut:klíč meta WordPressu:typ. Příklad: "
"%1$s. Typy: %2$s nebo %3$s."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Uložení vlastního pole"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr ""
"Nechte výchozí hodnoty, pokud vaše integrace nepoužívá jiné klíče meta "
"uživatelů."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "Přípona hodnoty LDAP"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Ukládá hodnotu LDAP, například phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "Přípona hodnoty WordPress"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Ukládá editovatelnou hodnotu WordPress, například phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Jednotné přihlášení (SSO)"

#: pro/src/Admin.php:83
msgid ""
"Your web server must authenticate users and set REMOTE_USER. Never copy a "
"browser header into REMOTE_USER or allow access that bypasses server "
"authentication. Set the LDAP search account on Connection."
msgstr ""
"Váš webový server musí autentizovat uživatele a nastavit REMOTE_USER. Nikdy "
"nekopírujte hlavičku prohlížeče do REMOTE_USER ani neumožňujte přístup, "
"který obchází autentizaci serveru. Nastavte účet pro vyhledávání LDAP v "
"sekci Připojení."

#: pro/src/Admin.php:84
msgid "Enable automatic login after web server authentication."
msgstr "Povolit automatické přihlášení po autentizaci webového serveru."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Autentizace webového serveru"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER je přítomen."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER chybí. Zkontrolujte konfiguraci webového serveru."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"Aktualizace byla zastavena. Aktivujte Simple LDAP Login Pro pro obnovení "
"LDAP přihlášení."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Aktualizace zablokována: Tento balíček neobsahuje všechny Pro soubory. Pro "
"instalaci verze Free nejprve deaktivujte plugin. Vaše nainstalované soubory "
"a nastavení zůstávají nezměněny."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress se nepodařilo znovu aktivovat plugin."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login vyžaduje PHP 8.1 nebo novější."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr "Soubory pluginu chybí. Znovu nainstalujte Simple LDAP Login z vydaného ZIP."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "Nemáte oprávnění měnit tato nastavení."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "Rozsah nastavení se změnil. Otevřete stránku nastavení a zkuste to znovu."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "Nemáte oprávnění zobrazit tato nastavení."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Nastavení sítě"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Nastavení webu"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "Nastavení přihlášení LDAP"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr "Připojte se k LDAP a poté otestujte přihlášení před povolením autentizace."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr "Přihlášení LDAP a SSO jsou zakázány pomocí SLL_DISABLE_LDAP v wp-config.php."

#: src/Admin.php:163
msgid ""
"Your saved settings use SSO or custom user fields. Install Simple LDAP "
"Login Pro to use these features. Your settings are kept."
msgstr ""
"Vaše uložené nastavení používá SSO nebo vlastní uživatelská pole. "
"Nainstalujte Simple LDAP Login Pro, abyste mohli tyto funkce používat. Vaše "
"nastavení jsou uchována."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"Uložené heslo pro vyhledávání LDAP nelze přečíst. Zadejte ho znovu na kartě "
"Připojení."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP chybí. Požádejte svého poskytovatele hostingu, aby jej "
"nainstaloval před povolením LDAP přihlášení."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"LDAP hesla jsou odesílána bez šifrování. Použijte StartTLS nebo LDAPS, "
"pokud to váš server podporuje."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Uložit nastavení"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "Nastavení na ostatních záložkách jsou uchována."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "LDAP připojení"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "LDAP přihlášení"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Povolit LDAP autentizaci."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Typ adresáře"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / jiný LDAP adresář"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "LDAP servery"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr "Jedno hostname nebo IP adresa na řádek. Servery se zkouší v pořadí."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Základní DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Kde hledat uživatele. Příklad: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Přípona uživatelského jména"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Přidáno k uživatelským jménům bez domény. Příklad: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Windows doména"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr ""
"Krátké jméno domény, například EXAMPLE. Má přednost před příponou "
"uživatelského jména."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Bezpečnost připojení"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS vyžaduje důvěryhodný certifikát serveru."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (doporučeno)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "Nešifrovaný LDAP"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "Nešifrovaný LDAP vyžaduje povolení na záložce Pokročilé."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Port"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 pro StartTLS; 636 pro LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Hledat podadresáře"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Hledat ve všech organizačních jednotkách pod základním DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "LDAP vyhledávací účet"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "LDAP účet s přístupem pro čtení uživatelů a skupin."

#: src/Admin.php:253
msgid "Search account"
msgstr "Vyhledávací účet"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "LDAP bind DN nebo název účtu."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "Heslo vyhledávacího účtu"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "Nechte prázdné pro zachování uloženého hesla."

#: src/Admin.php:262
msgid "Login rules"
msgstr "Pravidla přihlášení"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Vyžadovat LDAP hesla"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Blokovat WordPress hesla kromě přístupu pro obnovu."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Místní přístup pro obnovu"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Vybraní administrátoři"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Všichni super administrátoři (legacy)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Všichni administrátoři (legacy)"

#: src/Admin.php:270
msgid "Off"
msgstr "Vypnuto"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr "Vyberte, kdo může použít WordPress heslo, když jsou vyžadována LDAP hesla."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "Automatické vytváření účtů"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "Vytvořit WordPress účet při prvním úspěšném LDAP přihlášení."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "Výchozí role"

#: src/Admin.php:280
msgid "For new accounts only."
msgstr "Pouze pro nové účty."

#: src/Admin.php:281
#: src/Settings.php:609
msgid "Required groups"
msgstr "Požadované skupiny"

#: src/Admin.php:281
msgid ""
"One group name per line. Users must belong to at least one. Leave blank to "
"allow all LDAP users."
msgstr ""
"Jedno jméno skupiny na řádek. Uživatelé musí patřit alespoň do jedné. "
"Nechte prázdné pro povolení všem LDAP uživatelům."

#: src/Admin.php:295
#: src/Settings.php:613
msgid "Recovery accounts"
msgstr "Účty pro obnovu"

#: src/Admin.php:305
msgid ""
"For Selected administrators only. Use separate local accounts with "
"WordPress passwords. Hold Ctrl or Command to select multiple accounts."
msgstr ""
"Pouze pro vybrané administrátory. Použijte samostatné místní účty s "
"WordPress hesly. Držte Ctrl nebo Command pro výběr více účtů."

#: src/Admin.php:320
msgid "Connection options"
msgstr "Možnosti připojení"

#: src/Admin.php:320
msgid "Change these only if the default values do not work with your directory."
msgstr "Změňte tyto hodnoty pouze pokud výchozí hodnoty nefungují s vaším adresářem."

#: src/Admin.php:321
msgid "LDAP timeout (seconds)"
msgstr "Časový limit LDAP (vteřiny)"

#: src/Admin.php:321
msgid "Maximum wait for an LDAP operation. Default: 5 seconds."
msgstr "Maximální čekání na LDAP operaci. Výchozí: 5 vteřin."

#: src/Admin.php:322
#: src/Settings.php:606
msgid "Login attribute"
msgstr "Atribut přihlášení"

#: src/Admin.php:322
msgid "Attribute used to find users. Default: uid."
msgstr "Atribut používaný k nalezení uživatelů. Výchozí: uid."

#: src/Admin.php:323
msgid "Allow unencrypted LDAP"
msgstr "Povolit nešifrovaný LDAP"

#: src/Admin.php:323
msgid "Allow passwords to be sent without encryption."
msgstr "Povolit odesílání hesel bez šifrování."

#: src/Admin.php:325
msgid "Group search"
msgstr "Skupinové vyhledávání"

#: src/Admin.php:326
#: src/Settings.php:610
msgid "Group base DN"
msgstr "Základní DN skupiny"

#: src/Admin.php:326
msgid "Leave blank to use the user Base DN."
msgstr "Nechte prázdné pro použití základního DN uživatele."

#: src/Admin.php:327
#: src/Settings.php:607
msgid "Group name attribute"
msgstr "Atribut názvu skupiny"

#: src/Admin.php:327
msgid "Default: cn."
msgstr "Výchozí: cn."

#: src/Admin.php:328
#: src/Settings.php:608
msgid "Group member attribute"
msgstr "Atribut člena skupiny"

#: src/Admin.php:328
msgid "Default: memberUid. Use member or uniqueMember if groups store user DNs."
msgstr ""
"Výchozí: memberUid. Použijte member nebo uniqueMember, pokud skupiny "
"ukládají uživatelské DNy."

#: src/Admin.php:330
msgid "Profile attributes"
msgstr "Atributy profilu"

#: src/Admin.php:330
msgid "LDAP attributes copied to new WordPress accounts."
msgstr "Atributy LDAP zkopírované do nových účtů WordPress."

#: src/Admin.php:331
#: src/Settings.php:618
msgid "First name attribute"
msgstr "Atribut jména"

#: src/Admin.php:332
#: src/Settings.php:619
msgid "Last name attribute"
msgstr "Atribut příjmení"

#: src/Admin.php:333
#: src/Settings.php:620
msgid "Email attribute"
msgstr "Atribut e-mailu"

#: src/Admin.php:334
#: src/Settings.php:621
msgid "Website attribute"
msgstr "Atribut webových stránek"

#: src/Admin.php:337
msgid "Data retention"
msgstr "Uchovávání dat"

#: src/Admin.php:338
msgid "Delete settings when removing the plugin"
msgstr "Odstranit nastavení při odinstalaci pluginu"

#: src/Admin.php:338
msgid ""
"Delete saved settings and LDAP credentials when WordPress deletes the "
"plugin. Keep user accounts."
msgstr ""
"Odstranit uložená nastavení a LDAP přihlašovací údaje, když WordPress "
"odinstaluje plugin. Udržet uživatelské účty."

#: src/Admin.php:346
#: src/Admin.php:382
msgid "Test LDAP login"
msgstr "Test LDAP přihlášení"

#: src/Admin.php:346
msgid ""
"Save your settings, then run both tests. Keep this administrator session "
"open."
msgstr ""
"Uložte svá nastavení, poté spusťte oba testy. Nechte tuto administrátorskou "
"relaci otevřenou."

#: src/Admin.php:348
msgid ""
"Tests check the connection, password, and required groups. They do not "
"create accounts or sign users in."
msgstr ""
"Testy kontrolují připojení, heslo a požadované skupiny. Nezakládají účty "
"ani nepřihlašují uživatele."

#: src/Admin.php:349
msgid "After both tests pass, enable LDAP and try logging in from another browser."
msgstr ""
"Po úspěšném dokončení obou testů povolte LDAP a zkuste se přihlásit z "
"jiného prohlížeče."

#: src/Admin.php:350
msgid "Recovery"
msgstr "Obnova"

#: src/Admin.php:351
msgid ""
"If you are locked out, rename the simple-ldap-login folder using your "
"hosting file manager. Log in with a WordPress administrator password, then "
"restore the folder and correct the settings."
msgstr ""
"Pokud jste uzamčeni, přejmenujte složku simple-ldap-login pomocí správce "
"souborů vašeho hostingu. Přihlaste se pomocí hesla administrátora "
"WordPress, poté obnovte složku a opravte nastavení."

#: src/Admin.php:352
msgid ""
"For certificate errors, ask your host to configure the trusted LDAP "
"certificate authority."
msgstr ""
"Pro chyby certifikátu požádejte svého hostitele, aby nakonfiguroval "
"důvěryhodnou certifikační autoritu LDAP."

#: src/Admin.php:366
msgid "LDAP tests"
msgstr "LDAP testy"

#: src/Admin.php:367
msgid "Tests use saved settings."
msgstr "Testy používají uložená nastavení."

#: src/Admin.php:372
msgid "1. Test connection"
msgstr "1. Test připojení"

#: src/Admin.php:373
msgid "Connect to LDAP and test the search account, if set."
msgstr "Připojte se k LDAP a otestujte vyhledávací účet, pokud je nastaven."

#: src/Admin.php:374
msgid "Test connection"
msgstr "Test připojení"

#: src/Admin.php:378
msgid "2. Test login"
msgstr "2. Test přihlášení"

#: src/Admin.php:379
msgid "Check an LDAP username, password, and group membership."
msgstr "Zkontrolujte uživatelské jméno LDAP, heslo a členství ve skupině."

#: src/Admin.php:380
msgid "LDAP username"
msgstr "Uživatelské jméno LDAP"

#: src/Admin.php:381
msgid "LDAP password"
msgstr "Heslo LDAP"

#: src/Admin.php:537
msgid "Settings saved."
msgstr "Nastavení uložena."

#: src/Admin.php:538
msgid "Connection test passed."
msgstr "Test připojení byl úspěšný."

#: src/Admin.php:539
msgid ""
"Cannot connect to LDAP. Check the server, port, TLS certificate, and search "
"account."
msgstr ""
"Nelze se připojit k LDAP. Zkontrolujte server, port, TLS certifikát a "
"vyhledávací účet."

#: src/Admin.php:540
msgid "LDAP login test passed. No account was created."
msgstr "Test přihlášení LDAP byl úspěšný. Žádný účet nebyl vytvořen."

#: src/Admin.php:541
msgid "LDAP login test failed. Check the username, password, and required groups."
msgstr ""
"Test přihlášení LDAP selhal. Zkontrolujte uživatelské jméno, heslo a "
"požadované skupiny."

#: src/Admin.php:542
msgid "Could not save settings. Check the values and try again."
msgstr "Nastavení se nepodařilo uložit. Zkontrolujte hodnoty a zkuste to znovu."

#: src/Admin.php:586
msgid "Connection"
msgstr "Připojení"

#: src/Admin.php:587
msgid "Access"
msgstr "Přístup"

#: src/Admin.php:588
msgid "Advanced"
msgstr "Pokročilé"

#: src/Admin.php:589
msgid "Troubleshooting"
msgstr "Odstraňování problémů"

#: src/Authenticator.php:151
msgid ""
"Your LDAP login is valid, but you need a WordPress account. Contact your "
"site administrator."
msgstr ""
"Vaše LDAP přihlášení je platné, ale potřebujete účet WordPress. Kontaktujte "
"svého správce stránek."

#: src/Authenticator.php:154
msgid ""
"Your LDAP username is not a valid WordPress username. Contact your site "
"administrator."
msgstr ""
"Vaše uživatelské jméno LDAP není platné uživatelské jméno WordPress. "
"Kontaktujte svého správce stránek."

#: src/Authenticator.php:158
msgid ""
"The default WordPress role is not available. Contact your site "
"administrator."
msgstr "Výchozí role WordPress není k dispozici. Kontaktujte svého správce stránek."

#: src/Authenticator.php:175
msgid "Could not create your WordPress account. Contact your site administrator."
msgstr ""
"Nepodařilo se vytvořit váš účet WordPress. Kontaktujte svého správce "
"stránek."

#: src/Authenticator.php:180
msgid "Use your WordPress password for this recovery account."
msgstr "Použijte své heslo WordPress pro tento účet pro obnovu."

#: src/Ldap_Client.php:440
msgid ""
"LDAP login failed. Check your username and password or contact your site "
"administrator."
msgstr ""
"LDAP přihlášení selhalo. Zkontrolujte své uživatelské jméno a heslo nebo "
"kontaktujte svého správce stránek."

#: src/Ldap_Client.php:442
msgid "Your account is not allowed to log in to this site."
msgstr "Váš účet nemá povolení se přihlásit na tuto stránku."

#: src/Ldap_Client.php:444
msgid "LDAP login is unavailable. Contact your site administrator."
msgstr "Přihlášení pomocí LDAP není k dispozici. Kontaktujte správce vašeho webu."

#: src/Secrets.php:24
msgid "PHP OpenSSL is required to save the LDAP search password."
msgstr "PHP OpenSSL je vyžadován pro uložení hesla pro vyhledávání LDAP."

#: src/Secrets.php:92
msgid ""
"Could not read or save the LDAP search password. Enter it again. If this "
"continues, ask your host to check OpenSSL and the encryption key."
msgstr ""
"Nelze přečíst nebo uložit heslo pro vyhledávání LDAP. Zadejte ho znovu. "
"Pokud to bude pokračovat, požádejte svého hostitele, aby zkontroloval "
"OpenSSL a šifrovací klíč."

#: src/Settings.php:310
msgid ""
"Select a recovery account on the Access tab, or turn local recovery access "
"Off."
msgstr ""
"Vyberte účet pro obnovení na kartě Přístup nebo vypněte místní přístup k "
"obnovení."

#: src/Settings.php:318
msgid ""
"Enable Allow unencrypted LDAP on the Advanced tab, or choose StartTLS or "
"LDAPS."
msgstr ""
"Povolte Povolit nešifrovaný LDAP na kartě Pokročilé, nebo vyberte StartTLS "
"nebo LDAPS."

#: src/Settings.php:341
msgid "A custom field mapping uses a protected or invalid WordPress user meta key."
msgstr ""
"Mapování vlastního pole používá chráněný nebo neplatný klíč uživatelských "
"metadat WordPressu."

#: src/Settings.php:346
msgid "Enter a Base DN and at least one LDAP server before enabling LDAP login."
msgstr ""
"Zadejte základní DN a alespoň jeden LDAP server před povolením přihlášení "
"pomocí LDAP."

#: src/Settings.php:349
msgid "WordPress could not save the settings. Try again."
msgstr "WordPress nemohl uložit nastavení. Zkuste to znovu."

#: src/Settings.php:604
msgid "LDAP protocol version"
msgstr "Verze protokolu LDAP"

#: src/Settings.php:605
msgid "LDAP timeout"
msgstr "Časový limit LDAP"

#: src/Settings.php:623
msgid "Check the submitted settings. No changes were saved."
msgstr "Zkontrolujte odeslaná nastavení. Žádné změny nebyly uloženy."

