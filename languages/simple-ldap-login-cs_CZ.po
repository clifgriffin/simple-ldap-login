msgstr "Přidáno k uživatelským jménům bez domény. Příklad: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Windows doména"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr ""
"Krátké jméno domény, například EXAMPLE. Má přednost před příponou "
"uživatelského jména."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Bezpečnost připojení"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS vyžaduje důvěryhodný certifikát serveru."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (doporučeno)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "Nešifrovaný LDAP"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "Nešifrovaný LDAP vyžaduje povolení na záložce Pokročilé."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Port"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 pro StartTLS; 636 pro LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Hledat podadresáře"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Hledat ve všech organizačních jednotkách pod základním DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "LDAP vyhledávací účet"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "LDAP účet s přístupem pro čtení uživatelů a skupin."

#: src/Admin.php:253
msgid "Search account"
msgstr "Vyhledávací účet"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "LDAP bind DN nebo název účtu."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "Heslo vyhledávacího účtu"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "Nechte prázdné pro zachování uloženého hesla."

#: src/Admin.php:262
msgid "Login rules"
msgstr "Pravidla přihlášení"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Vyžadovat LDAP hesla"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Blokovat WordPress hesla kromě přístupu pro obnovu."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Místní přístup pro obnovu"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Vybraní administrátoři"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Všichni super administrátoři (legacy)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Všichni administrátoři (legacy)"

#: src/Admin.php:270
msgid "Off"
msgstr "Vypnuto"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr "Vyberte, kdo může použít WordPress heslo, když jsou vyžadována LDAP hesla."

