msgstr "LDAP servery"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr "Jedno hostname nebo IP adresa na řádek. Servery se zkouší v pořadí."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Základní DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Kde hledat uživatele. Příklad: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Přípona uživatelského jména"

#: src/Admin.php:235
