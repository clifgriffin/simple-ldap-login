#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Conecte contas do WordPress ao Active Directory ou OpenLDAP."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Dados do usuário"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Login único"

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Campos de usuário personalizados"

#: pro/src/Admin.php:60
msgid "Copy LDAP attributes to WordPress user meta fields."
msgstr "Copie atributos LDAP para campos de meta do usuário do WordPress."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Mapeamentos de campo"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"Uma mapeamento por linha: atributo LDAP:chave meta do WordPress:tipo. "
"Exemplo: %1$s. Tipos: %2$s ou %3$s."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Armazenamento de campo personalizado"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr ""
"Deixe os padrões, a menos que sua integração use chaves de meta de usuário "
"diferentes."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "Sufixo de valor LDAP"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Armazena o valor LDAP, como phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "Sufixo de valor do WordPress"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Armazena o valor editável do WordPress, como phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Login único (SSO)"

#: pro/src/Admin.php:83
msgid ""
"Your web server must authenticate users and set REMOTE_USER. Never copy a "
"browser header into REMOTE_USER or allow access that bypasses server "
"authentication. Set the LDAP search account on Connection."
msgstr ""
"Seu servidor web deve autenticar usuários e definir REMOTE_USER. Nunca "
"copie um cabeçalho de navegador para REMOTE_USER ou permita acesso que "
"contorne a autenticação do servidor. Defina a conta de pesquisa LDAP na "
"Conexão."

#: pro/src/Admin.php:84
msgid "Enable automatic login after web server authentication."
msgstr "Ativar login automático após a autenticação do servidor web."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Autenticação do servidor web"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER está presente."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER está ausente. Verifique a configuração do servidor web."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"A atualização foi interrompida. Ative o Simple LDAP Login Pro para "
"restaurar o login LDAP."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Atualização bloqueada: Este pacote não inclui todos os arquivos Pro. Para "
"instalar o Free, desative o plugin primeiro. Seus arquivos e configurações "
"instalados permanecem inalterados."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "O WordPress não conseguiu reativar o plugin."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "O Simple LDAP Login precisa do PHP 8.1 ou posterior."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr ""
"Os arquivos do plugin estão ausentes. Reinstale o Simple LDAP Login a "
"partir do ZIP de lançamento."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "Você não tem permissão para alterar essas configurações."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr ""
"O escopo das configurações mudou. Abra a página de configurações e tente "
"novamente."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "Você não tem permissão para visualizar essas configurações."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Configurações de rede"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Configurações do site"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "Configurações de login LDAP"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr "Conecte-se ao LDAP e teste um login antes de habilitar a autenticação."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr ""
"O login LDAP e o SSO estão desativados por SLL_DISABLE_LDAP no "
"wp-config.php."

#: src/Admin.php:163
msgid ""
"Your saved settings use SSO or custom user fields. Install Simple LDAP "
"Login Pro to use these features. Your settings are kept."
msgstr ""
"Suas configurações salvas usam SSO ou campos de usuário personalizados. "
"Instale o Simple LDAP Login Pro para usar esses recursos. Suas "
"configurações estão mantidas."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"A senha de pesquisa LDAP salva não pode ser lida. Insira-a novamente na aba "
"Conexão."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"O PHP LDAP está ausente. Peça ao seu host para instalá-lo antes de "
"habilitar o login LDAP."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"As senhas LDAP são enviadas sem criptografia. Use StartTLS ou LDAPS se o "
"seu servidor suportar."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Salvar configurações"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "As configurações em outras abas são mantidas."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "Conexão LDAP"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "Login LDAP"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Habilitar autenticação LDAP."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Tipo de diretório"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / outro diretório LDAP"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "Servidores LDAP"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr ""
"Um nome de host ou endereço IP por linha. Os servidores são testados na "
"ordem."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Base DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Onde procurar usuários. Exemplo: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Sufixo do nome de usuário"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Adicionado a nomes de usuário sem domínio. Exemplo: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Domínio do Windows"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr ""
"Nome de domínio curto, como EXAMPLE. Tem prioridade sobre o sufixo do nome "
"de usuário."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Segurança da conexão"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS requer um certificado de servidor confiável."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (recomendado)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "LDAP não criptografado"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "LDAP não criptografado requer permissão na aba Avançado."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Porta"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 para StartTLS; 636 para LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Pesquisar subpastas"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Pesquisar todas as unidades organizacionais abaixo do Base DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "Conta de pesquisa LDAP"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "Uma conta LDAP com acesso de leitura a usuários e grupos."

#: src/Admin.php:253
msgid "Search account"
msgstr "Conta de pesquisa"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "DN de ligação LDAP ou nome da conta."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "Senha da conta de pesquisa"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "Deixe em branco para manter a senha salva."

#: src/Admin.php:262
msgid "Login rules"
msgstr "Regras de login"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Exigir senhas LDAP"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Bloquear senhas do WordPress, exceto para acesso de recuperação."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Acesso de recuperação local"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Administradores selecionados"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Todos os super administradores (legado)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Todos os administradores (legado)"

#: src/Admin.php:270
msgid "Off"
msgstr "Desligado"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr ""
"Escolha quem pode usar uma senha do WordPress quando as senhas LDAP são "
"exigidas."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "Criação automática de conta"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "Criar uma conta do WordPress no primeiro login LDAP bem-sucedido."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "Função padrão"

#: src/Admin.php:280
msgid "For new accounts only."
msgstr "Apenas para novas contas."

#: src/Admin.php:281
#: src/Settings.php:609
msgid "Required groups"
msgstr "Grupos obrigatórios"

#: src/Admin.php:281
msgid ""
"One group name per line. Users must belong to at least one. Leave blank to "
"allow all LDAP users."
msgstr ""
"Um nome de grupo por linha. Os usuários devem pertencer a pelo menos um. "
"Deixe em branco para permitir todos os usuários LDAP."

#: src/Admin.php:295
#: src/Settings.php:613
msgid "Recovery accounts"
msgstr "Contas de recuperação"

#: src/Admin.php:305
msgid ""
"For Selected administrators only. Use separate local accounts with "
"WordPress passwords. Hold Ctrl or Command to select multiple accounts."
msgstr ""
"Apenas para administradores selecionados. Use contas locais separadas com "
"senhas do WordPress. Mantenha Ctrl ou Command pressionado para selecionar "
"várias contas."

#: src/Admin.php:320
msgid "Connection options"
msgstr "Opções de conexão"

#: src/Admin.php:320
msgid "Change these only if the default values do not work with your directory."
msgstr "Altere isso apenas se os valores padrão não funcionarem com seu diretório."

#: src/Admin.php:321
msgid "LDAP timeout (seconds)"
msgstr "Tempo limite LDAP (segundos)"

#: src/Admin.php:321
msgid "Maximum wait for an LDAP operation. Default: 5 seconds."
msgstr "Tempo máximo de espera para uma operação LDAP. Padrão: 5 segundos."

#: src/Admin.php:322
#: src/Settings.php:606
msgid "Login attribute"
msgstr "Atributo de login"

#: src/Admin.php:322
msgid "Attribute used to find users. Default: uid."
msgstr "Atributo usado para encontrar usuários. Padrão: uid."

#: src/Admin.php:323
msgid "Allow unencrypted LDAP"
msgstr "Permitir LDAP não criptografado"

#: src/Admin.php:323
msgid "Allow passwords to be sent without encryption."
msgstr "Permitir que senhas sejam enviadas sem criptografia."

#: src/Admin.php:325
msgid "Group search"
msgstr "Pesquisa de grupo"

#: src/Admin.php:326
#: src/Settings.php:610
msgid "Group base DN"
msgstr "DN base do grupo"

#: src/Admin.php:326
msgid "Leave blank to use the user Base DN."
msgstr "Deixe em branco para usar o DN base do usuário."

#: src/Admin.php:327
#: src/Settings.php:607
msgid "Group name attribute"
msgstr "Atributo do nome do grupo"

#: src/Admin.php:327
msgid "Default: cn."
msgstr "Padrão: cn."

#: src/Admin.php:328
#: src/Settings.php:608
msgid "Group member attribute"
msgstr "Atributo do membro do grupo"

#: src/Admin.php:328
msgid "Default: memberUid. Use member or uniqueMember if groups store user DNs."
msgstr ""
"Padrão: memberUid. Use member ou uniqueMember se os grupos armazenarem DNs "
"de usuários."

#: src/Admin.php:330
msgid "Profile attributes"
msgstr "Atributos de perfil"

#: src/Admin.php:330
msgid "LDAP attributes copied to new WordPress accounts."
msgstr "Atributos LDAP copiados para novas contas do WordPress."

#: src/Admin.php:331
#: src/Settings.php:618
msgid "First name attribute"
msgstr "Atributo do primeiro nome"

#: src/Admin.php:332
#: src/Settings.php:619
msgid "Last name attribute"
msgstr "Atributo do sobrenome"

#: src/Admin.php:333
#: src/Settings.php:620
msgid "Email attribute"
msgstr "Atributo de e-mail"

#: src/Admin.php:334
#: src/Settings.php:621
msgid "Website attribute"
msgstr "Atributo do site"

#: src/Admin.php:337
msgid "Data retention"
msgstr "Retenção de dados"

#: src/Admin.php:338
msgid "Delete settings when removing the plugin"
msgstr "Excluir configurações ao remover o plugin"

#: src/Admin.php:338
msgid ""
"Delete saved settings and LDAP credentials when WordPress deletes the "
"plugin. Keep user accounts."
msgstr ""
"Excluir configurações salvas e credenciais LDAP quando o WordPress excluir "
"o plugin. Manter contas de usuário."

#: src/Admin.php:346
#: src/Admin.php:382
msgid "Test LDAP login"
msgstr "Testar login LDAP"

#: src/Admin.php:346
msgid ""
"Save your settings, then run both tests. Keep this administrator session "
"open."
msgstr ""
"Salve suas configurações e, em seguida, execute ambos os testes. Mantenha "
"esta sessão de administrador aberta."

#: src/Admin.php:348
msgid ""
"Tests check the connection, password, and required groups. They do not "
"create accounts or sign users in."
msgstr ""
"Os testes verificam a conexão, a senha e os grupos necessários. Eles não "
"criam contas nem fazem login de usuários."

#: src/Admin.php:349
msgid "After both tests pass, enable LDAP and try logging in from another browser."
msgstr ""
"Após a aprovação de ambos os testes, ative o LDAP e tente fazer login em "
"outro navegador."

#: src/Admin.php:350
msgid "Recovery"
msgstr "Recuperação"

#: src/Admin.php:351
msgid ""
"If you are locked out, rename the simple-ldap-login folder using your "
"hosting file manager. Log in with a WordPress administrator password, then "
"restore the folder and correct the settings."
msgstr ""
"Se você estiver bloqueado, renomeie a pasta simple-ldap-login usando o "
"gerenciador de arquivos do seu host. Faça login com uma senha de "
"administrador do WordPress, depois restaure a pasta e corrija as "
"configurações."

#: src/Admin.php:352
msgid ""
"For certificate errors, ask your host to configure the trusted LDAP "
"certificate authority."
msgstr ""
"Para erros de certificado, peça ao seu host para configurar a autoridade de "
"certificação LDAP confiável."

#: src/Admin.php:366
msgid "LDAP tests"
msgstr "Testes LDAP"

#: src/Admin.php:367
msgid "Tests use saved settings."
msgstr "Os testes usam configurações salvas."

#: src/Admin.php:372
msgid "1. Test connection"
msgstr "1. Testar conexão"

#: src/Admin.php:373
msgid "Connect to LDAP and test the search account, if set."
msgstr "Conecte-se ao LDAP e teste a conta de pesquisa, se configurada."

#: src/Admin.php:374
msgid "Test connection"
msgstr "Testar conexão"

#: src/Admin.php:378
msgid "2. Test login"
msgstr "2. Testar login"

#: src/Admin.php:379
msgid "Check an LDAP username, password, and group membership."
msgstr "Verifique um nome de usuário LDAP, senha e associação a grupos."

#: src/Admin.php:380
msgid "LDAP username"
msgstr "Nome de usuário LDAP"

#: src/Admin.php:381
msgid "LDAP password"
msgstr "Senha LDAP"

#: src/Admin.php:537
msgid "Settings saved."
msgstr "Configurações salvas."

#: src/Admin.php:538
msgid "Connection test passed."
msgstr "Teste de conexão aprovado."

#: src/Admin.php:539
msgid ""
"Cannot connect to LDAP. Check the server, port, TLS certificate, and search "
"account."
msgstr ""
"Não é possível conectar ao LDAP. Verifique o servidor, a porta, o "
"certificado TLS e a conta de pesquisa."

#: src/Admin.php:540
msgid "LDAP login test passed. No account was created."
msgstr "Teste de login LDAP aprovado. Nenhuma conta foi criada."

#: src/Admin.php:541
msgid "LDAP login test failed. Check the username, password, and required groups."
msgstr ""
"Teste de login LDAP falhou. Verifique o nome de usuário, a senha e os "
"grupos necessários."

#: src/Admin.php:542
msgid "Could not save settings. Check the values and try again."
msgstr ""
"Não foi possível salvar as configurações. Verifique os valores e tente "
"novamente."

#: src/Admin.php:586
msgid "Connection"
msgstr "Conexão"

#: src/Admin.php:587
msgid "Access"
msgstr "Acesso"

#: src/Admin.php:588
msgid "Advanced"
msgstr "Avançado"

#: src/Admin.php:589
msgid "Troubleshooting"
msgstr "Solução de problemas"

#: src/Authenticator.php:151
msgid ""
"Your LDAP login is valid, but you need a WordPress account. Contact your "
"site administrator."
msgstr ""
"Seu login LDAP é válido, mas você precisa de uma conta do WordPress. Entre "
"em contato com o administrador do seu site."

#: src/Authenticator.php:154
msgid ""
"Your LDAP username is not a valid WordPress username. Contact your site "
"administrator."
msgstr ""
"Seu nome de usuário LDAP não é um nome de usuário válido do WordPress. "
"Entre em contato com o administrador do seu site."

#: src/Authenticator.php:158
msgid ""
"The default WordPress role is not available. Contact your site "
"administrator."
msgstr ""
"O papel padrão do WordPress não está disponível. Entre em contato com o "
"administrador do seu site."

#: src/Authenticator.php:175
msgid "Could not create your WordPress account. Contact your site administrator."
msgstr ""
"Não foi possível criar sua conta do WordPress. Entre em contato com o "
"administrador do seu site."

#: src/Authenticator.php:180
msgid "Use your WordPress password for this recovery account."
msgstr "Use sua senha do WordPress para esta conta de recuperação."

#: src/Ldap_Client.php:440
msgid ""
"LDAP login failed. Check your username and password or contact your site "
"administrator."
msgstr ""
"Login LDAP falhou. Verifique seu nome de usuário e senha ou entre em "
"contato com o administrador do seu site."

#: src/Ldap_Client.php:442
msgid "Your account is not allowed to log in to this site."
msgstr "Sua conta não tem permissão para fazer login neste site."

#: src/Ldap_Client.php:444
msgid "LDAP login is unavailable. Contact your site administrator."
msgstr ""
"O login LDAP está indisponível. Entre em contato com o administrador do "
"site."

#: src/Secrets.php:24
msgid "PHP OpenSSL is required to save the LDAP search password."
msgstr "PHP OpenSSL é necessário para salvar a senha de pesquisa LDAP."

#: src/Secrets.php:92
msgid ""
"Could not read or save the LDAP search password. Enter it again. If this "
"continues, ask your host to check OpenSSL and the encryption key."
msgstr ""
"Não foi possível ler ou salvar a senha de pesquisa LDAP. Digite-a "
"novamente. Se isso continuar, peça ao seu host para verificar o OpenSSL e a "
"chave de criptografia."

#: src/Settings.php:310
msgid ""
"Select a recovery account on the Access tab, or turn local recovery access "
"Off."
msgstr ""
"Selecione uma conta de recuperação na aba Acesso ou desative o acesso de "
"recuperação local."

#: src/Settings.php:318
msgid ""
"Enable Allow unencrypted LDAP on the Advanced tab, or choose StartTLS or "
"LDAPS."
msgstr ""
"Ative Permitir LDAP não criptografado na aba Avançado ou escolha StartTLS "
"ou LDAPS."

#: src/Settings.php:341
msgid "A custom field mapping uses a protected or invalid WordPress user meta key."
msgstr ""
"Um mapeamento de campo personalizado usa uma chave de meta de usuário do "
"WordPress protegida ou inválida."

#: src/Settings.php:346
msgid "Enter a Base DN and at least one LDAP server before enabling LDAP login."
msgstr ""
"Digite um DN Base e pelo menos um servidor LDAP antes de ativar o login "
"LDAP."

#: src/Settings.php:349
msgid "WordPress could not save the settings. Try again."
msgstr "O WordPress não conseguiu salvar as configurações. Tente novamente."

#: src/Settings.php:604
msgid "LDAP protocol version"
msgstr "Versão do protocolo LDAP"

#: src/Settings.php:605
msgid "LDAP timeout"
msgstr "Tempo limite do LDAP"

#: src/Settings.php:623
