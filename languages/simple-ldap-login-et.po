#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Ühendage WordPressi kontod Active Directory või OpenLDAP-iga."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Kasutaja andmed"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Üksik sisselogimine"

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Kohandatud kasutaja väljad"

#: pro/src/Admin.php:60
msgid "Copy LDAP attributes to WordPress user meta fields."
msgstr "Kopeerige LDAP atribuudid WordPressi kasutaja meta väljadele."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Väljade kaardistamine"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"Üks kaardistus rea kohta: LDAP atribuut:WordPress meta võti:tüüp. Näide: "
"%1$s. Tüübid: %2$s või %3$s."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Kohandatud väljade salvestamine"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr ""
"Jätke vaikeväärtused, kui teie integratsioon ei kasuta erinevaid kasutaja "
"meta võtmeid."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "LDAP väärtuse sufiks"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Salvestab LDAP väärtuse, näiteks phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "WordPressi väärtuse sufiks"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Salvestab muudetava WordPressi väärtuse, näiteks phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Üksik sisselogimine (SSO)"

#: pro/src/Admin.php:83
msgid ""
"Your web server must authenticate users and set REMOTE_USER. Never copy a "
"browser header into REMOTE_USER or allow access that bypasses server "
"authentication. Set the LDAP search account on Connection."
msgstr ""
"Teie veebiserver peab autentima kasutajad ja seadma REMOTE_USER. Ärge "
"kunagi kopeerige brauseri päist REMOTE_USER-isse ega lubage juurdepääsu, "
"mis möödub serveri autentimisest. Seadke LDAP otsingu konto ühenduse "
"seadetes."

#: pro/src/Admin.php:84
msgid "Enable automatic login after web server authentication."
msgstr "Lubage automaatne sisselogimine pärast veebiserveri autentimist."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Veebiserveri autentimine"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER on olemas."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER puudub. Kontrollige veebiserveri konfiguratsiooni."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"Uuendus peatati. Aktiveerige Simple LDAP Login Pro, et taastada LDAP "
"sisselogimine."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Uuendus blokeeritud: See pakett ei sisalda kõiki Pro faile. Tasuta "
"installimiseks deaktiveerige plugin esmalt. Teie installitud failid ja "
"seaded jäävad muutumatuks."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress ei saanud plugina uuesti aktiveerida."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login vajab PHP 8.1 või uuemat."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr "Pluginafailid puuduvad. Taaskäivitage Simple LDAP Login välja ZIP-failist."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "Teil ei ole õigust neid seadeid muuta."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "Seadete ulatus on muutunud. Avage seadete leht ja proovige uuesti."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "Teil ei ole õigust neid seadeid vaadata."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Võrgu seaded"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Saidiseaded"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "LDAP sisselogimise seaded"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr "Ühendage LDAP-iga, seejärel testige sisselogimist enne autentimise lubamist."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr ""
"LDAP sisselogimine ja SSO on keelatud SLL_DISABLE_LDAP tõttu "
"wp-config.php-s."

#: src/Admin.php:163
msgid ""
"Your saved settings use SSO or custom user fields. Install Simple LDAP "
"Login Pro to use these features. Your settings are kept."
msgstr ""
"Teie salvestatud seaded kasutavad SSO-d või kohandatud kasutajavälju. "
"Installige Simple LDAP Login Pro, et neid funktsioone kasutada. Teie seaded "
"on salvestatud."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"Salvestatud LDAP otsingu parooli ei saa lugeda. Sisestage see uuesti "
"Ühenduse vahelehel."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP puudub. Paluge oma hostil see enne LDAP sisselogimise lubamist "
"installida."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"LDAP paroolid saadetakse krüpteerimata. Kasutage StartTLS või LDAPS, kui "
"teie server seda toetab."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Salvesta seaded"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "Muude vahekaartide seaded jäävad alles."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "LDAP ühendus"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "LDAP sisselogimine"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Luba LDAP autentimine."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Katalooge tüüp"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / muu LDAP kataloog"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "LDAP serverid"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr ""
"Üks hostinimi või IP-aadress iga rea kohta. Servereid proovitatakse "
"järjekorras."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Baasi DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Kus otsida kasutajaid. Näide: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Kasutajanime sufiks"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Lisatakse domeenita kasutajanimedele. Näide: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Windowsi domeen"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr ""
"Lühike domeeninimi, näiteks EXAMPLE. Omab prioriteeti kasutajanime sufiksi "
"üle."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Ühenduse turvalisus"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS nõuab usaldusväärset serveri sertifikaati."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (soovitatav)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "Krüpteerimata LDAP"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "Krüpteerimata LDAP nõuab lubamist Täiendava vahekaart."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Port"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 StartTLS jaoks; 636 LDAPS jaoks."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Otsi alamkaustad"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Otsi kõiki organisatsioonilisi üksusi allpool Baasi DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "LDAP otsingu konto"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "LDAP konto, millel on lugemisõigus kasutajatele ja gruppidele."

#: src/Admin.php:253
msgid "Search account"
msgstr "Otsingu konto"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "LDAP sidumise DN või konto nimi."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "Otsingu konto parool"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "Jätke tühi, et hoida salvestatud parool."

#: src/Admin.php:262
msgid "Login rules"
msgstr "Sisselogimise reeglid"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Nõua LDAP paroole"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Blokeeri WordPressi paroolid, välja arvatud taastamisjuurdepääs."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Kohalik taastamisjuurdepääs"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Valitud administraatorid"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Kõik super administraatorid (pärand)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Kõik administraatorid (pärand)"

#: src/Admin.php:270
msgid "Off"
msgstr "Väljas"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr ""
"Valige, kes saavad kasutada WordPressi parooli, kui LDAP paroolid on "
"nõutavad."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "Automaatne konto loomine"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "Looge WordPressi konto esimese eduka LDAP sisselogimise korral."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "Vaikimisi roll"

#: src/Admin.php:280
msgid "For new accounts only."
msgstr "Ainult uute kontode jaoks."

#: src/Admin.php:281
#: src/Settings.php:609
msgid "Required groups"
msgstr "Nõutavad grupid"

#: src/Admin.php:281
msgid ""
"One group name per line. Users must belong to at least one. Leave blank to "
"allow all LDAP users."
msgstr ""
"Üks grupi nimi iga rea kohta. Kasutajad peavad kuuluma vähemalt ühte. Jätke "
"tühi, et lubada kõiki LDAP kasutajaid."

#: src/Admin.php:295
#: src/Settings.php:613
msgid "Recovery accounts"
msgstr "Taastamiskontod"

#: src/Admin.php:305
msgid ""
"For Selected administrators only. Use separate local accounts with "
"WordPress passwords. Hold Ctrl or Command to select multiple accounts."
msgstr ""
"Ainult valitud administraatorite jaoks. Kasutage eraldi kohalikke kontosid "
"WordPressi paroolidega. Hoidke Ctrl või Command all, et valida mitu kontot."

#: src/Admin.php:320
msgid "Connection options"
msgstr "Ühenduse valikud"

#: src/Admin.php:320
msgid "Change these only if the default values do not work with your directory."
msgstr "Muutke neid ainult siis, kui vaikeseaded ei tööta teie kataloogiga."

#: src/Admin.php:321
msgid "LDAP timeout (seconds)"
msgstr "LDAP aegumine (sekundites)"

#: src/Admin.php:321
msgid "Maximum wait for an LDAP operation. Default: 5 seconds."
msgstr "Maksimaalne ooteaeg LDAP toiminguks. Vaikimisi: 5 sekundit."

#: src/Admin.php:322
#: src/Settings.php:606
msgid "Login attribute"
msgstr "Sisselogimise atribuut"

#: src/Admin.php:322
msgid "Attribute used to find users. Default: uid."
msgstr "Atribuut, mida kasutatakse kasutajate leidmiseks. Vaikimisi: uid."

#: src/Admin.php:323
msgid "Allow unencrypted LDAP"
msgstr "Luba krüpteerimata LDAP"

#: src/Admin.php:323
msgid "Allow passwords to be sent without encryption."
msgstr "Luba paroolide saatmine krüpteerimata."

#: src/Admin.php:325
msgid "Group search"
msgstr "Rühma otsing"

#: src/Admin.php:326
#: src/Settings.php:610
msgid "Group base DN"
msgstr "Rühma baas DN"

#: src/Admin.php:326
msgid "Leave blank to use the user Base DN."
msgstr "Jätke tühi, et kasutada kasutaja baas DN-i."

#: src/Admin.php:327
#: src/Settings.php:607
msgid "Group name attribute"
msgstr "Rühma nime atribuut"

#: src/Admin.php:327
msgid "Default: cn."
msgstr "Vaikimisi: cn."

#: src/Admin.php:328
#: src/Settings.php:608
msgid "Group member attribute"
msgstr "Rühma liikme atribuut"

#: src/Admin.php:328
msgid "Default: memberUid. Use member or uniqueMember if groups store user DNs."
msgstr ""
"Vaikimisi: memberUid. Kasutage member või uniqueMember, kui rühmad "
"salvestavad kasutaja DN-id."

#: src/Admin.php:330
msgid "Profile attributes"
msgstr "Profiili atribuudid"

#: src/Admin.php:330
msgid "LDAP attributes copied to new WordPress accounts."
msgstr "LDAP atribuudid, mis kopeeritakse uutele WordPressi kontodele."

#: src/Admin.php:331
#: src/Settings.php:618
msgid "First name attribute"
msgstr "Eesnimi atribuut"

#: src/Admin.php:332
#: src/Settings.php:619
msgid "Last name attribute"
msgstr "Perekonnanimi atribuut"

#: src/Admin.php:333
#: src/Settings.php:620
msgid "Email attribute"
msgstr "E-posti atribuut"

#: src/Admin.php:334
#: src/Settings.php:621
msgid "Website attribute"
msgstr "Veebisaidi atribuut"

#: src/Admin.php:337
msgid "Data retention"
msgstr "Andmete säilitamine"

#: src/Admin.php:338
msgid "Delete settings when removing the plugin"
msgstr "Kustuta seaded, kui plugina eemaldad"

#: src/Admin.php:338
msgid ""
"Delete saved settings and LDAP credentials when WordPress deletes the "
"plugin. Keep user accounts."
msgstr ""
"Kustuta salvestatud seaded ja LDAP-i mandaadid, kui WordPress eemaldab "
"plugina. Hoia kasutajakontosid."

#: src/Admin.php:346
#: src/Admin.php:382
msgid "Test LDAP login"
msgstr "Testi LDAP-i sisselogimist"

#: src/Admin.php:346
msgid ""
"Save your settings, then run both tests. Keep this administrator session "
"open."
msgstr ""
"Salvesta oma seaded ja seejärel tee mõlemad testid. Hoia see "
"administraatori sessioon avatud."

#: src/Admin.php:348
msgid ""
"Tests check the connection, password, and required groups. They do not "
"create accounts or sign users in."
msgstr ""
"Testid kontrollivad ühendust, parooli ja nõutud gruppe. Need ei loo "
"kontosid ega logi kasutajaid sisse."

#: src/Admin.php:349
msgid "After both tests pass, enable LDAP and try logging in from another browser."
msgstr ""
"Pärast mõlema testi edukat sooritamist lülita LDAP sisse ja proovi sisse "
"logida teisest brauserist."

#: src/Admin.php:350
msgid "Recovery"
msgstr "Taastamine"

#: src/Admin.php:351
msgid ""
"If you are locked out, rename the simple-ldap-login folder using your "
"hosting file manager. Log in with a WordPress administrator password, then "
"restore the folder and correct the settings."
msgstr ""
"Kui oled lukus, nimeta simple-ldap-login kaust ümber, kasutades oma "
"hostimise failihaldurit. Logi sisse WordPressi administraatori parooliga, "
"seejärel taasta kaust ja paranda seaded."

#: src/Admin.php:352
msgid ""
"For certificate errors, ask your host to configure the trusted LDAP "
"certificate authority."
msgstr ""
"Sertifikaadi vigade korral palu oma hostil seadistada usaldusväärne LDAP "
"sertifikaadi autoriteet."

#: src/Admin.php:366
msgid "LDAP tests"
msgstr "LDAP testid"

#: src/Admin.php:367
msgid "Tests use saved settings."
msgstr "Testid kasutavad salvestatud seadeid."

#: src/Admin.php:372
msgid "1. Test connection"
msgstr "1. Testi ühendust"

#: src/Admin.php:373
msgid "Connect to LDAP and test the search account, if set."
msgstr "Ühenda LDAP-iga ja testi otsingu kontot, kui see on seadistatud."

#: src/Admin.php:374
msgid "Test connection"
msgstr "Testi ühendust"

#: src/Admin.php:378
msgid "2. Test login"
msgstr "2. Testi sisselogimist"

#: src/Admin.php:379
msgid "Check an LDAP username, password, and group membership."
msgstr "Kontrolli LDAP-i kasutajanime, parooli ja grupi kuuluvust."

#: src/Admin.php:380
msgid "LDAP username"
msgstr "LDAP-i kasutajanimi"

#: src/Admin.php:381
msgid "LDAP password"
msgstr "LDAP-i parool"

#: src/Admin.php:537
msgid "Settings saved."
msgstr "Seaded salvestatud."

#: src/Admin.php:538
msgid "Connection test passed."
msgstr "Ühenduse test läbitud."

#: src/Admin.php:539
msgid ""
"Cannot connect to LDAP. Check the server, port, TLS certificate, and search "
"account."
msgstr ""
"Ei saa LDAP-iga ühendust luua. Kontrolli serverit, porti, TLS-i "
"sertifikaati ja otsingu kontot."

#: src/Admin.php:540
msgid "LDAP login test passed. No account was created."
msgstr "LDAP-i sisselogimise test läbitud. Konto ei loodud."

#: src/Admin.php:541
msgid "LDAP login test failed. Check the username, password, and required groups."
msgstr ""
"LDAP-i sisselogimise test ebaõnnestus. Kontrolli kasutajanime, parooli ja "
"nõutud gruppe."

#: src/Admin.php:542
msgid "Could not save settings. Check the values and try again."
msgstr "Seadeid ei saanud salvestada. Kontrolli väärtusi ja proovi uuesti."

#: src/Admin.php:586
msgid "Connection"
msgstr "Ühendus"

#: src/Admin.php:587
msgid "Access"
msgstr "Juurdepääs"

#: src/Admin.php:588
msgid "Advanced"
msgstr "Täpsem"

#: src/Admin.php:589
msgid "Troubleshooting"
msgstr "Tõrkeotsing"

#: src/Authenticator.php:151
msgid ""
"Your LDAP login is valid, but you need a WordPress account. Contact your "
"site administrator."
msgstr ""
"Sinu LDAP-i sisselogimine on kehtiv, kuid sul on vaja WordPressi kontot. "
"Võta ühendust oma saidi administraatoriga."

#: src/Authenticator.php:154
msgid ""
"Your LDAP username is not a valid WordPress username. Contact your site "
"administrator."
msgstr ""
"Sinu LDAP-i kasutajanimi ei ole kehtiv WordPressi kasutajanimi. Võta "
"ühendust oma saidi administraatoriga."

#: src/Authenticator.php:158
msgid ""
"The default WordPress role is not available. Contact your site "
"administrator."
msgstr ""
"Vaikimisi WordPressi roll ei ole saadaval. Võta ühendust oma saidi "
"administraatoriga."

#: src/Authenticator.php:175
msgid "Could not create your WordPress account. Contact your site administrator."
msgstr ""
"Sinu WordPressi konto loomine ebaõnnestus. Võta ühendust oma saidi "
"administraatoriga."

#: src/Authenticator.php:180
msgid "Use your WordPress password for this recovery account."
msgstr "Kasutage oma WordPressi parooli selle taastamiskonto jaoks."

#: src/Ldap_Client.php:440
msgid ""
"LDAP login failed. Check your username and password or contact your site "
"administrator."
msgstr ""
"LDAP-i sisselogimine ebaõnnestus. Kontrolli oma kasutajanime ja parooli või "
"võta ühendust oma saidi administraatoriga."

#: src/Ldap_Client.php:442
msgid "Your account is not allowed to log in to this site."
msgstr "Teie konto ei ole lubatud sellele saidile sisse logida."

#: src/Ldap_Client.php:444
msgid "LDAP login is unavailable. Contact your site administrator."
msgstr ""
"LDAP sisselogimine ei ole saadaval. Võtke ühendust oma saidi "
"administraatoriga."

#: src/Secrets.php:24
msgid "PHP OpenSSL is required to save the LDAP search password."
msgstr "PHP OpenSSL on vajalik LDAP otsinguparooli salvestamiseks."

#: src/Secrets.php:92
msgid ""
"Could not read or save the LDAP search password. Enter it again. If this "
"continues, ask your host to check OpenSSL and the encryption key."
msgstr ""
"LDAP otsinguparooli ei saanud lugeda ega salvestada. Sisestage see uuesti. "
"Kui see jätkub, paluge oma hostil kontrollida OpenSSL-i ja "
"krüpteerimisvõtit."

#: src/Settings.php:310
msgid ""
"Select a recovery account on the Access tab, or turn local recovery access "
"Off."
msgstr ""
"Valige juurdepääsu vahekaardilt taastamiskonto või keelake kohaliku "
"taastamise juurdepääs."

#: src/Settings.php:318
msgid ""
"Enable Allow unencrypted LDAP on the Advanced tab, or choose StartTLS or "
