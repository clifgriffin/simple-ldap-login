msgstr "저장된 비밀번호를 유지하려면 비워 두세요."

#: src/Admin.php:262
msgid "Login rules"
msgstr "로그인 규칙"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "LDAP 비밀번호 요구"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "복구 접근을 제외하고 WordPress 비밀번호를 차단합니다."

#: src/Admin.php:266
#: src/Settings.php:612
