#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "เชื่อมต่อบัญชี WordPress กับ Active Directory หรือ OpenLDAP."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Admin.php:49
msgid "User data"
msgstr "ข้อมูลผู้ใช้"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "การเข้าสู่ระบบแบบครั้งเดียว"

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "ฟิลด์ผู้ใช้ที่กำหนดเอง"

#: pro/src/Admin.php:60
msgid ""
"Copy LDAP fields, such as phone number or department, to WordPress at "
"login. Your theme or other plugins can use these values."
msgstr ""
"คัดลอกฟิลด์ LDAP เช่น หมายเลขโทรศัพท์หรือแผนกไปยัง WordPress "
"ในขณะเข้าสู่ระบบ ธีมหรือปลั๊กอินอื่น ๆ ของคุณสามารถใช้ค่เหล่านี้ได้"

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "การแมพฟิลด์"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"หนึ่งการแมพต่อหนึ่งบรรทัด: คุณสมบัติ LDAP: คีย์เมตาของ WordPress: ประเภท. "
"ตัวอย่าง: %1$s. ประเภท: %2$s หรือ %3$s."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "การจัดเก็บฟิลด์ที่กำหนดเอง"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr "ปล่อยให้เป็นค่าเริ่มต้นเว้นแต่การรวมของคุณใช้คีย์เมตาผู้ใช้ที่แตกต่างกัน."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "ซัฟฟิกซ์ค่าของ LDAP"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "เก็บค่าของ LDAP เช่น phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "ซัฟฟิกซ์ค่าของ WordPress"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "เก็บค่าที่แก้ไขได้ของ WordPress เช่น phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "การเข้าสู่ระบบแบบครั้งเดียว (SSO)"

#: pro/src/Admin.php:84
msgid "Sign users in to WordPress after your web server authenticates them."
msgstr ""
"ลงชื่อเข้าใช้ผู้ใช้ใน WordPress "
"หลังจากที่เซิร์ฟเวอร์เว็บของคุณตรวจสอบสิทธิ์พวกเขา"

#: pro/src/Admin.php:85
msgid "Enable single sign-on"
msgstr "เปิดใช้งานการเข้าสู่ระบบแบบเดี่ยว"

#: pro/src/Admin.php:85
msgid "Users do not need a second login for WordPress."
msgstr "ผู้ใช้ไม่จำเป็นต้องเข้าสู่ระบบครั้งที่สองสำหรับ WordPress"

#: pro/src/Admin.php:87
msgid ""
"Configure your web server to authenticate users and set REMOTE_USER. Enter "
"an LDAP search account on Connection."
msgstr ""
"กำหนดค่าเซิร์ฟเวอร์เว็บของคุณเพื่อตรวจสอบสิทธิ์ผู้ใช้และตั้งค่า REMOTE_USER "
"ป้อนบัญชีค้นหา LDAP ในการเชื่อมต่อ"

#: pro/src/Admin.php:88
msgid ""
"Do not copy browser headers into REMOTE_USER. Block access that bypasses "
"web server authentication."
msgstr ""
"อย่าคัดลอกส่วนหัวของเบราว์เซอร์ไปยัง REMOTE_USER "
"ปิดกั้นการเข้าถึงที่หลีกเลี่ยงการตรวจสอบสิทธิ์ของเซิร์ฟเวอร์เว็บ"

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "การตรวจสอบสิทธิ์เซิร์ฟเวอร์เว็บ"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER มีอยู่."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER ขาดหายไป. ตรวจสอบการกำหนดค่าของเซิร์ฟเวอร์เว็บ."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"การอัปเดตถูกหยุดลง เปิดใช้งาน Simple LDAP Login Pro "
"เพื่อกู้คืนการเข้าสู่ระบบ LDAP."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"การอัปเดตถูกบล็อก: แพ็คเกจนี้ไม่มีไฟล์ Pro ทั้งหมด หากต้องการติดตั้ง Free "
"ให้ปิดการใช้งานปลั๊กอินก่อน "
"ไฟล์และการตั้งค่าที่ติดตั้งของคุณจะไม่เปลี่ยนแปลง."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress ไม่สามารถเปิดใช้งานปลั๊กอินอีกครั้ง."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login ต้องการ PHP 8.1 หรือใหม่กว่า."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr "ไฟล์ปลั๊กอินหายไป. ติดตั้ง Simple LDAP Login ใหม่จาก ZIP ที่ปล่อยออกมา."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "คุณไม่มีสิทธิ์ในการเปลี่ยนแปลงการตั้งค่าเหล่านี้."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "ขอบเขตการตั้งค่าได้เปลี่ยนแปลง. เปิดหน้าการตั้งค่าและลองอีกครั้ง."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "คุณไม่มีสิทธิ์ในการดูการตั้งค่าเหล่านี้."

#: src/Admin.php:153
msgid "Network settings"
msgstr "การตั้งค่าเครือข่าย"

#: src/Admin.php:153
msgid "Site settings"
msgstr "การตั้งค่าไซต์"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "การตั้งค่าการเข้าสู่ระบบ LDAP"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr "เชื่อมต่อกับ LDAP แล้วทดสอบการเข้าสู่ระบบก่อนเปิดใช้งานการตรวจสอบสิทธิ์."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr "การเข้าสู่ระบบ LDAP และ SSO ถูกปิดโดย SLL_DISABLE_LDAP ใน wp-config.php."

#: src/Admin.php:163
msgid ""
"Your saved settings use SSO or custom user fields. Install Simple LDAP "
"Login Pro to use these features. Your settings are kept."
msgstr ""
"การตั้งค่าที่คุณบันทึกไว้ใช้ SSO หรือฟิลด์ผู้ใช้ที่กำหนดเอง ติดตั้ง Simple "
"LDAP Login Pro เพื่อใช้ฟีเจอร์เหล่านี้ การตั้งค่าของคุณจะถูกเก็บไว้"

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"รหัสผ่านการค้นหา LDAP ที่บันทึกไม่สามารถอ่านได้. "
"ป้อนอีกครั้งในแท็บการเชื่อมต่อ."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP หายไป กรุณาขอให้โฮสต์ของคุณติดตั้งก่อนเปิดใช้งานการเข้าสู่ระบบ "
"LDAP."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"รหัสผ่าน LDAP ถูกส่งโดยไม่มีการเข้ารหัส ใช้ StartTLS หรือ LDAPS "
"หากเซิร์ฟเวอร์ของคุณรองรับ."

#: src/Admin.php:207
msgid "Save settings"
msgstr "บันทึกการตั้งค่า"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "การตั้งค่าในแท็บอื่น ๆ จะถูกเก็บไว้."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "การเชื่อมต่อ LDAP"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "การเข้าสู่ระบบ LDAP"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "เปิดใช้งานการตรวจสอบสิทธิ์ LDAP."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "ประเภทไดเรกทอรี"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / ไดเรกทอรี LDAP อื่น ๆ"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "เซิร์ฟเวอร์ LDAP"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr "ชื่อโฮสต์หรือที่อยู่ IP หนึ่งต่อบรรทัด เซิร์ฟเวอร์จะถูกลองในลำดับ."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Base DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "ที่ค้นหาผู้ใช้ ตัวอย่าง: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Suffix ชื่อผู้ใช้"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "เพิ่มไปยังชื่อผู้ใช้ที่ไม่มีโดเมน ตัวอย่าง: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "โดเมน Windows"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr "ชื่อโดเมนสั้น เช่น EXAMPLE มีลำดับความสำคัญเหนือ suffix ชื่อผู้ใช้."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "ความปลอดภัยในการเชื่อมต่อ"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS ต้องการใบรับรองเซิร์ฟเวอร์ที่เชื่อถือได้."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (แนะนำ)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "LDAP ที่ไม่มีการเข้ารหัส"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "LDAP ที่ไม่มีการเข้ารหัสต้องการสิทธิ์ในแท็บขั้นสูง."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "พอร์ต"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 สำหรับ StartTLS; 636 สำหรับ LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "ค้นหาย่อย"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "ค้นหาทุกหน่วยงานที่องค์กรด้านล่าง Base DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "บัญชีค้นหา LDAP"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "บัญชี LDAP ที่มีสิทธิ์อ่านผู้ใช้และกลุ่ม."

#: src/Admin.php:253
msgid "Search account"
msgstr "บัญชีค้นหา"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "LDAP bind DN หรือชื่อบัญชี."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "รหัสผ่านบัญชีค้นหา"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "ปล่อยว่างเพื่อเก็บรหัสผ่านที่บันทึกไว้."

#: src/Admin.php:262
msgid "Login rules"
msgstr "กฎการเข้าสู่ระบบ"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "ต้องการรหัสผ่าน LDAP"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "บล็อกรหัสผ่าน WordPress ยกเว้นสำหรับการเข้าถึงการกู้คืน."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "การเข้าถึงการกู้คืนในท้องถิ่น"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "ผู้ดูแลระบบที่เลือก"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "ผู้ดูแลระบบซุปเปอร์ทั้งหมด (legacy)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "ผู้ดูแลระบบทั้งหมด (legacy)"

#: src/Admin.php:270
msgid "Off"
msgstr "ปิด"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr "เลือกผู้ที่สามารถใช้รหัสผ่าน WordPress เมื่อรหัสผ่าน LDAP ถูกต้อง."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "การสร้างบัญชีอัตโนมัติ"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "สร้างบัญชี WordPress เมื่อเข้าสู่ระบบ LDAP สำเร็จครั้งแรก."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "บทบาทเริ่มต้น"

#: src/Admin.php:280
msgid "For new accounts only."
msgstr "สำหรับบัญชีใหม่เท่านั้น."

#: src/Admin.php:281
#: src/Settings.php:609
msgid "Required groups"
msgstr "กลุ่มที่จำเป็น"

#: src/Admin.php:281
msgid ""
"One group name per line. Users must belong to at least one. Leave blank to "
"allow all LDAP users."
msgstr ""
"ชื่อกลุ่มหนึ่งต่อบรรทัด ผู้ใช้ต้องเป็นสมาชิกของอย่างน้อยหนึ่งกลุ่ม "
"ปล่อยว่างเพื่ออนุญาตให้ผู้ใช้ LDAP ทั้งหมด."

#: src/Admin.php:295
#: src/Settings.php:613
msgid "Recovery accounts"
msgstr "บัญชีการกู้คืน"

#: src/Admin.php:305
msgid ""
"For Selected administrators only. Use separate local accounts with "
"WordPress passwords. Hold Ctrl or Command to select multiple accounts."
msgstr ""
"สำหรับผู้ดูแลระบบที่เลือกเท่านั้น ใช้บัญชีท้องถิ่นแยกต่างหากที่มีรหัสผ่าน "
"WordPress กด Ctrl หรือ Command เพื่อเลือกหลายบัญชี."

#: src/Admin.php:320
msgid "Connection options"
msgstr "ตัวเลือกการเชื่อมต่อ"

#: src/Admin.php:320
msgid "Change these only if the default values do not work with your directory."
msgstr "เปลี่ยนแปลงเหล่านี้เฉพาะเมื่อค่าพื้นฐานไม่ทำงานกับไดเรกทอรีของคุณ."

#: src/Admin.php:321
msgid "LDAP timeout (seconds)"
msgstr "เวลาหมดอายุ LDAP (วินาที)"

#: src/Admin.php:321
msgid "Maximum wait for an LDAP operation. Default: 5 seconds."
msgstr "เวลาสูงสุดในการรอการดำเนินการ LDAP ค่าพื้นฐาน: 5 วินาที."

#: src/Admin.php:322
#: src/Settings.php:606
msgid "Login attribute"
msgstr "คุณลักษณะการเข้าสู่ระบบ"

#: src/Admin.php:322
msgid "Attribute used to find users. Default: uid."
msgstr "คุณลักษณะที่ใช้ในการค้นหาผู้ใช้ ค่าพื้นฐาน: uid."

#: src/Admin.php:323
msgid "Allow unencrypted LDAP"
msgstr "อนุญาต LDAP ที่ไม่มีการเข้ารหัส"

#: src/Admin.php:323
msgid "Allow passwords to be sent without encryption."
msgstr "อนุญาตให้ส่งรหัสผ่านโดยไม่มีการเข้ารหัส."

#: src/Admin.php:325
msgid "Group search"
msgstr "การค้นหากลุ่ม"

#: src/Admin.php:326
#: src/Settings.php:610
msgid "Group base DN"
msgstr "DN ฐานกลุ่ม"

#: src/Admin.php:326
msgid "Leave blank to use the user Base DN."
msgstr "ปล่อยว่างเพื่อใช้ DN ฐานผู้ใช้."

#: src/Admin.php:327
#: src/Settings.php:607
msgid "Group name attribute"
msgstr "คุณสมบัติชื่อกลุ่ม"

#: src/Admin.php:327
msgid "Default: cn."
msgstr "ค่าเริ่มต้น: cn."

#: src/Admin.php:328
#: src/Settings.php:608
msgid "Group member attribute"
msgstr "คุณสมบัติสมาชิกกลุ่ม"

#: src/Admin.php:328
msgid "Default: memberUid. Use member or uniqueMember if groups store user DNs."
msgstr ""
"ค่าเริ่มต้น: memberUid. ใช้ member หรือ uniqueMember หากกลุ่มเก็บ DN "
"ของผู้ใช้."

