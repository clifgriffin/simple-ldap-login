#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Подключите учетные записи WordPress к Active Directory или OpenLDAP."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Accounts.php:205
msgid "Your directory account is suspended. Contact your site administrator."
msgstr ""
"Ваша учётная запись каталога заблокирована. Обратитесь к администратору "
"сайта."

#: pro/src/Accounts.php:249
msgid "The directory identity has changed. Contact your site administrator."
msgstr ""
"Идентификатор учётной записи в каталоге изменился. Обратитесь к "
"администратору сайта."

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Данные пользователя"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Единый вход"

#: pro/src/Admin.php:59
msgid "Accounts"
msgstr "Учётные записи"

#: pro/src/Admin.php:60
msgid "Audit"
msgstr "Аудит"

#: pro/src/Admin.php:70
msgid "Profile updates"
msgstr "Обновления профилей"

#: pro/src/Admin.php:70
msgid ""
"Copy standard LDAP profile fields to existing WordPress accounts at login. "
"Recovery accounts and super administrators are excluded."
msgstr ""
"Копировать стандартные поля профиля LDAP в существующие учётные записи "
"WordPress при входе. Учётные записи восстановления и суперадминистраторы "
"исключены."

#: pro/src/Admin.php:71
msgid "Update profiles at login"
msgstr "Обновлять профили при входе"

#: pro/src/Admin.php:71
msgid ""
"Replace names, email, and website with directory values. Empty directory "
"values clear the field. A missing or invalid email stops the update."
msgstr ""
"Заменять имена, адрес электронной почты и сайт значениями из каталога. "
"Пустые значения в каталоге очищают поле. Отсутствующий или неверный адрес "
"электронной почты останавливает обновление."

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Пользовательские поля"

#: pro/src/Admin.php:60
msgid ""
"Copy LDAP fields, such as phone number or department, to WordPress at "
"login. Your theme or other plugins can use these values."
msgstr ""
"Копируйте поля LDAP, такие как номер телефона или отдел, в WordPress при "
"входе. Ваша тема или другие плагины могут использовать эти значения."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Сопоставление полей"

#: pro/src/Admin.php:81
msgid "LDAP attribute"
msgstr "Атрибут LDAP"

#: pro/src/Admin.php:85
msgid "WordPress meta key"
msgstr "Ключ метаданных WordPress"

#: pro/src/Admin.php:89
msgid "Type"
msgstr "Тип"

#: pro/src/Admin.php:91
msgid "Text"
msgstr "Текст"

#: pro/src/Admin.php:92
msgid "Number"
msgstr "Число"

#: pro/src/Admin.php:85
msgid "Group roles"
msgstr "Роли групп"

#: pro/src/Admin.php:85
msgid ""
"Set the WordPress role from LDAP groups at each login. The first matching "
"rule applies. If no rule matches, use the default role. Recovery accounts "
"and super administrators are excluded."
msgstr ""
"Назначать роль WordPress по группам LDAP при каждом входе. Применяется "
"первое подходящее правило. Если ни одно правило не подходит, используется "
"роль по умолчанию. Учётные записи восстановления и суперадминистраторы "
"исключены."

#: pro/src/Admin.php:86
msgid "Group-to-role rules"
msgstr "Правила назначения ролей группам"

#: pro/src/Admin.php:112
#: pro/src/Admin.php:155
msgid "LDAP group"
msgstr "Группа LDAP"

#: pro/src/Admin.php:116
#: pro/src/Admin.php:164
msgid "WordPress role"
msgstr "Роль WordPress"

#: pro/src/Admin.php:108
msgid ""
"Enterprise includes scheduled account import, scheduled access removal, and "
"multisite membership rules. Your saved settings are kept."
msgstr ""
"Enterprise включает плановый импорт учётных записей, плановое отключение "
"доступа и правила членства в сети сайтов. Сохранённые настройки сохраняются."

#: pro/src/Admin.php:108
#: pro/src/Audit.php:224
msgid "View Enterprise upgrade"
msgstr "Посмотреть переход на Enterprise"

#: pro/src/Admin.php:113
msgid "Enterprise account settings"
msgstr "Настройки учётных записей Enterprise"

#: pro/src/Admin.php:97
msgid "Multisite membership"
msgstr "Участие в сети сайтов"

#: pro/src/Admin.php:97
msgid ""
"Assign site membership and roles from directory groups. The first matching "
"rule for each site applies. These rules replace the group role rules for "
"network activation."
msgstr ""
"Назначать участие в сайтах и роли по группам каталога. Для каждого сайта "
"применяется первое подходящее правило. При активации в сети эти правила "
"заменяют правила ролей групп."

#: pro/src/Admin.php:98
msgid "Group-to-site rules"
msgstr "Правила назначения сайтов группам"

#: pro/src/Audit.php:231
msgid "Site ID"
msgstr "ID сайта"

#: pro/src/Admin.php:101
msgid "Scheduled account import"
msgstr "Импорт учётных записей по расписанию"

#: pro/src/Admin.php:101
msgid ""
"Import directory accounts once per hour through WordPress scheduled tasks. "
"Set a search account on Connection. Site traffic or a system task must run "
"WordPress cron."
msgstr ""
"Импортировать учётные записи каталога раз в час через запланированные "
"задачи WordPress. Задайте учётную запись поиска на вкладке «Подключение». "
"Посещения сайта или системная задача должны запускать cron WordPress."

#: pro/src/Admin.php:102
msgid "Enable scheduled import"
msgstr "Включить импорт по расписанию"

#: pro/src/Admin.php:102
msgid ""
"Create accounts without a first login. Existing local accounts are "
"excluded. No user session is created."
msgstr ""
"Создавать учётные записи без первого входа. Существующие локальные учётные "
"записи исключены. Сеанс пользователя не создаётся."

#: pro/src/Admin.php:103
msgid "Import Base DN"
msgstr "Базовый DN импорта"

#: pro/src/Admin.php:103
msgid "Leave blank to use the connection Base DN."
msgstr "Оставьте пустым, чтобы использовать базовый DN подключения."

#: pro/src/Admin.php:104
msgid "Import groups"
msgstr "Группы для импорта"

#: pro/src/Admin.php:104
msgid ""
"One group per line. Import users in at least one group. Leave blank to "
"import all users below the Import Base DN. Login group restrictions also "
"apply."
msgstr ""
"Одна группа на строку. Импортируются пользователи хотя бы одной из этих "
"групп. Оставьте пустым для импорта всех пользователей в поддереве базового "
"DN импорта. Ограничения групп входа также действуют."

#: pro/src/Admin.php:106
msgid "Scheduled access removal"
msgstr "Отзыв доступа по расписанию"

#: pro/src/Admin.php:106
msgid ""
"Check managed directory accounts once per hour. A confirmed missing "
"account, disabled AD account, changed directory identity, or failed login "
"group rule suspends access and ends all WordPress sessions. Connection "
"errors keep the current access state."
msgstr ""
"Проверять управляемые учётные записи каталога раз в час. Подтверждённое "
"отсутствие учётной записи, отключённая учётная запись AD, изменение "
"идентификатора в каталоге или невыполненное правило группы входа блокируют "
"доступ и завершают все сеансы WordPress. Ошибки подключения сохраняют "
"текущее состояние доступа."

#: pro/src/Admin.php:107
msgid "Enable scheduled access removal"
msgstr "Включить отзыв доступа по расписанию"

#: pro/src/Admin.php:107
msgid ""
"Keep user data and content. Restore access after a later successful "
"directory check. Recovery accounts and super administrators are excluded. "
"Existing suspensions remain if the task or license stops."
msgstr ""
"Сохранять данные и содержимое пользователей. Восстанавливать доступ после "
"последующей успешной проверки каталога. Учётные записи восстановления и "
"суперадминистраторы исключены. Существующие блокировки сохраняются при "
"остановке задачи или прекращении действия лицензии."

#: pro/src/Admin.php:207
msgid "Add row"
msgstr "Добавить строку"

#: pro/src/Admin.php:260
msgid "Move up"
msgstr "Переместить вверх"

#: pro/src/Admin.php:261
msgid "Move down"
msgstr "Переместить вниз"

#: pro/src/Admin.php:262
msgid "Remove row"
msgstr "Удалить строку"

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Хранение пользовательских полей"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr ""
"Оставьте значения по умолчанию, если ваша интеграция не использует другие "
"мета-ключи пользователя."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "Суффикс значения LDAP"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Хранит значение LDAP, например phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "Суффикс значения WordPress"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Хранит редактируемое значение WordPress, например phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Единый вход (SSO)"

#: pro/src/Admin.php:84
msgid "Sign users in to WordPress after your web server authenticates them."
msgstr "Авторизуйте пользователей в WordPress после их аутентификации веб-сервером."

#: pro/src/Admin.php:85
msgid "Enable single sign-on"
msgstr "Включить единую аутентификацию"

#: pro/src/Admin.php:85
msgid "Users do not need a second login for WordPress."
msgstr "Пользователям не требуется второй вход в WordPress."

#: pro/src/Admin.php:87
msgid ""
"Configure your web server to authenticate users and set REMOTE_USER. Enter "
"an LDAP search account on Connection."
msgstr ""
"Настройте ваш веб-сервер для аутентификации пользователей и установите "
"REMOTE_USER. Введите учетную запись поиска LDAP в разделе Подключение."

#: pro/src/Admin.php:88
msgid ""
"Do not copy browser headers into REMOTE_USER. Block access that bypasses "
"web server authentication."
msgstr ""
"Не копируйте заголовки браузера в REMOTE_USER. Блокируйте доступ, который "
"обходит аутентификацию веб-сервера."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Аутентификация веб-сервера"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER присутствует."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER отсутствует. Проверьте конфигурацию веб-сервера."

#: pro/src/Audit.php:224
msgid ""
"An Enterprise license is required to collect, read, or export audit "
"history. Existing records are kept."
msgstr ""
"Для сбора, чтения или экспорта истории аудита нужна лицензия Enterprise. "
"Существующие записи сохраняются."

#: pro/src/Audit.php:229
msgid "Enterprise audit settings"
msgstr "Настройки аудита Enterprise"

#: pro/src/Audit.php:211
msgid "Audit history"
msgstr "История аудита"

#: pro/src/Audit.php:211
msgid ""
"Record login results and account changes. Records contain event names and "
"account IDs. Passwords, directory field values, and credentials are "
"excluded."
msgstr ""
"Регистрировать результаты входа и изменения учётных записей. Записи "
"содержат названия событий и ID учётных записей. Пароли, значения полей "
"каталога и данные доступа исключены."

#: pro/src/Audit.php:212
msgid "Enable audit history"
msgstr "Включить историю аудита"

#: pro/src/Audit.php:212
msgid ""
"Store private WordPress records. Collection is off by default. Existing "
"records remain when collection stops."
msgstr ""
"Хранить закрытые записи WordPress. Сбор по умолчанию отключён. Существующие "
"записи сохраняются при остановке сбора."

#: pro/src/Audit.php:213
msgid "Retention (days)"
msgstr "Срок хранения (дни)"

#: pro/src/Audit.php:213
msgid ""
"Default: 30. Range: 1 to 3650. A daily task removes older records while "
"collection is enabled."
msgstr ""
"По умолчанию: 30. Диапазон: от 1 до 3650. Ежедневная задача удаляет старые "
"записи, пока сбор включён."

#: pro/src/Audit.php:229
msgid "Export CSV"
msgstr "Экспорт CSV"

#: pro/src/Audit.php:230
msgid ""
"Latest 50 records. The export includes all retained records in this scope. "
"Times use UTC."
msgstr ""
"Последние 50 записей. Экспорт включает все сохранённые записи в этой "
"области. Время указано в UTC."

#: pro/src/Audit.php:231
msgid "Time (UTC)"
msgstr "Время (UTC)"

#: pro/src/Audit.php:231
msgid "Event"
msgstr "Событие"

#: pro/src/Audit.php:231
msgid "Actor ID"
msgstr "ID исполнителя"

#: pro/src/Audit.php:231
msgid "User ID"
msgstr "ID пользователя"

#: pro/src/Audit.php:253
msgid "You do not have permission to export these records."
msgstr "У вас нет разрешения на экспорт этих записей."

#: pro/src/Settings_Rules.php:53
msgid ""
"Activate an Enterprise license to change these settings. Your saved "
"settings are kept."
msgstr ""
"Активируйте лицензию Enterprise, чтобы изменить эти настройки. Сохранённые "
"настройки сохраняются."

#: pro/src/Settings_Rules.php:130
msgid "A Pro setting is not valid. Check the format and role names."
msgstr "Недопустимый параметр Pro. Проверьте формат и названия ролей."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"Обновление было остановлено. Активируйте Simple LDAP Login Pro, чтобы "
"восстановить LDAP-вход."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Обновление заблокировано: этот пакет не включает все файлы Pro. Чтобы "
"установить Free, сначала деактивируйте плагин. Ваши установленные файлы и "
"настройки остаются без изменений."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress не смог повторно активировать плагин."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login требует PHP 8.1 или новее."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr ""
"Файлы плагина отсутствуют. Переустановите Simple LDAP Login из ZIP-архива "
"релиза."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "У вас нет разрешения на изменение этих настроек."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "Область настроек изменилась. Откройте страницу настроек и попробуйте снова."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "У вас нет разрешения на просмотр этих настроек."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Сетевые настройки"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Настройки сайта"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "Настройки входа через LDAP"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr ""
"Подключитесь к LDAP, затем протестируйте вход перед включением "
"аутентификации."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr "Вход через LDAP и SSO отключены из-за SLL_DISABLE_LDAP в wp-config.php."

#: src/Admin.php:164
msgid ""
"Your saved settings use backup LDAP servers, SSO, or custom user fields. "
"Install Simple LDAP Login Pro to use these features. Your settings are kept."
msgstr ""
"Сохранённые настройки используют резервные серверы LDAP, SSO или "
"настраиваемые поля пользователей. Установите Simple LDAP Login Pro для "
"использования этих функций. Ваши настройки сохраняются."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"Сохраненный пароль поиска LDAP не может быть прочитан. Введите его снова на "
"вкладке Подключение."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP отсутствует. Попросите вашего хостинг-провайдера установить его "
"перед включением LDAP входа."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"Пароли LDAP отправляются без шифрования. Используйте StartTLS или LDAPS, "
"если ваш сервер это поддерживает."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Сохранить настройки"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "Настройки на других вкладках сохранены."

#: src/Admin.php:215
msgid ""
"Save settings before you check the connection. The check uses saved "
"settings."
msgstr ""
"Сохраните настройки перед проверкой подключения. Проверка использует "
"сохранённые настройки."

#: src/Admin.php:219
#: src/Admin.php:391
#: src/Admin.php:393
msgid "Check Connection"
msgstr "Проверить подключение"

#: src/Admin.php:221
msgid "Open the Testing tab for login tests and more information."
msgstr ""
"Откройте вкладку «Тестирование» для проверки входа и дополнительной "
"информации."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "LDAP соединение"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "LDAP вход"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Включить LDAP аутентификацию."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Тип каталога"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / другой LDAP каталог"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "LDAP серверы"

#: src/Admin.php:242
msgid ""
"One hostname or IP address per line. An active Pro or Enterprise license "
"enables backup servers. Without an active license, only the first server is "
"used."
msgstr ""
"Одно имя хоста или IP-адрес в каждой строке. Активная лицензия Pro или "
"Enterprise позволяет использовать резервные серверы. Без активной лицензии "
"используется только первый сервер."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Базовый DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Где искать пользователей. Пример: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Суффикс имени пользователя"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Добавляется к именам пользователей без домена. Пример: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Домашний домен"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr ""
"Короткое имя домена, например EXAMPLE. Имеет приоритет над суффиксом имени "
"пользователя."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
