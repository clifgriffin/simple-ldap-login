#: Simple-LDAP-Login.php src/Admin.php:64 src/Admin.php:65 src/Admin.php:149
#. Plugin Name of the plugin
msgid "Simple LDAP Login"
msgstr "Simple LDAP Login"

#: Simple-LDAP-Login.php
#. Plugin URI of the plugin
msgid "https://github.com/clifgriffin/simple-ldap-login"
msgstr "https://github.com/clifgriffin/simple-ldap-login"

#: Simple-LDAP-Login.php
#. Description of the plugin
msgid "Connect WordPress accounts to Active Directory or OpenLDAP."
msgstr "Подключите учетные записи WordPress к Active Directory или OpenLDAP."

#: Simple-LDAP-Login.php
#. Author of the plugin
msgid "Clif Griffin Development Inc."
msgstr "Clif Griffin Development Inc."

#: Simple-LDAP-Login.php
#. Author URI of the plugin
msgid "https://clifgriffin.com"
msgstr "https://clifgriffin.com"

#: pro/src/Admin.php:49
msgid "User data"
msgstr "Данные пользователя"

#: pro/src/Admin.php:50
#: pro/src/Admin.php:84
msgid "Single sign-on"
msgstr "Единый вход"

#: pro/src/Admin.php:60
msgid "Custom user fields"
msgstr "Пользовательские поля"

#: pro/src/Admin.php:60
msgid ""
"Copy LDAP fields, such as phone number or department, to WordPress at "
"login. Your theme or other plugins can use these values."
msgstr ""
"Копируйте поля LDAP, такие как номер телефона или отдел, в WordPress при "
"входе. Ваша тема или другие плагины могут использовать эти значения."

#: pro/src/Admin.php:61
#: src/Settings.php:615
msgid "Field mappings"
msgstr "Сопоставление полей"

#: pro/src/Admin.php:62
#. translators: 1: Example field mapping, 2: Text type identifier, 3: Number type identifier.
#, php-format
msgid ""
"One mapping per line: LDAP attribute:WordPress meta key:type. Example: "
"%1$s. Types: %2$s or %3$s."
msgstr ""
"Одна сопоставление на строку: атрибут LDAP:ключ метаданных WordPress:тип. "
"Пример: %1$s. Типы: %2$s или %3$s."

#: pro/src/Admin.php:71
msgid "Custom field storage"
msgstr "Хранение пользовательских полей"

#: pro/src/Admin.php:71
msgid "Leave the defaults unless your integration uses different user meta keys."
msgstr ""
"Оставьте значения по умолчанию, если ваша интеграция не использует другие "
"мета-ключи пользователя."

#: pro/src/Admin.php:72
#: src/Settings.php:616
msgid "LDAP value suffix"
msgstr "Суффикс значения LDAP"

#: pro/src/Admin.php:72
msgid "Stores the LDAP value, such as phone_ldap."
msgstr "Хранит значение LDAP, например phone_ldap."

#: pro/src/Admin.php:73
#: src/Settings.php:617
msgid "WordPress value suffix"
msgstr "Суффикс значения WordPress"

#: pro/src/Admin.php:73
msgid "Stores the editable WordPress value, such as phone_wp."
msgstr "Хранит редактируемое значение WordPress, например phone_wp."

#: pro/src/Admin.php:83
msgid "Single sign-on (SSO)"
msgstr "Единый вход (SSO)"

#: pro/src/Admin.php:84
msgid "Sign users in to WordPress after your web server authenticates them."
msgstr "Авторизуйте пользователей в WordPress после их аутентификации веб-сервером."

#: pro/src/Admin.php:85
msgid "Enable single sign-on"
msgstr "Включить единую аутентификацию"

#: pro/src/Admin.php:85
msgid "Users do not need a second login for WordPress."
msgstr "Пользователям не требуется второй вход в WordPress."

#: pro/src/Admin.php:87
msgid ""
"Configure your web server to authenticate users and set REMOTE_USER. Enter "
"an LDAP search account on Connection."
msgstr ""
"Настройте ваш веб-сервер для аутентификации пользователей и установите "
"REMOTE_USER. Введите учетную запись поиска LDAP в разделе Подключение."

#: pro/src/Admin.php:88
msgid ""
"Do not copy browser headers into REMOTE_USER. Block access that bypasses "
"web server authentication."
msgstr ""
"Не копируйте заголовки браузера в REMOTE_USER. Блокируйте доступ, который "
"обходит аутентификацию веб-сервера."

#: pro/src/Admin.php:87
msgid "Web server authentication"
msgstr "Аутентификация веб-сервера"

#: pro/src/Admin.php:88
msgid "REMOTE_USER is present."
msgstr "REMOTE_USER присутствует."

#: pro/src/Admin.php:88
msgid "REMOTE_USER is missing. Check the web server configuration."
msgstr "REMOTE_USER отсутствует. Проверьте конфигурацию веб-сервера."

#: pro/src/Upgrade_Guard.php:84
msgid ""
"The update was stopped. Activate Simple LDAP Login Pro to restore LDAP "
"login."
msgstr ""
"Обновление было остановлено. Активируйте Simple LDAP Login Pro, чтобы "
"восстановить LDAP-вход."

#: pro/src/Upgrade_Guard.php:86
msgid ""
"Update blocked: This package does not include all Pro files. To install "
"Free, deactivate the plugin first. Your installed files and settings are "
"unchanged."
msgstr ""
"Обновление заблокировано: этот пакет не включает все файлы Pro. Чтобы "
"установить Free, сначала деактивируйте плагин. Ваши установленные файлы и "
"настройки остаются без изменений."

#: pro/src/Upgrade_Guard.php:113
msgid "WordPress could not reactivate the plugin."
msgstr "WordPress не смог повторно активировать плагин."

#: Simple-LDAP-Login.php:29
msgid "Simple LDAP Login needs PHP 8.1 or later."
msgstr "Simple LDAP Login требует PHP 8.1 или новее."

#: Simple-LDAP-Login.php:39
msgid "Plugin files are missing. Reinstall Simple LDAP Login from the release ZIP."
msgstr ""
"Файлы плагина отсутствуют. Переустановите Simple LDAP Login из ZIP-архива "
"релиза."

#: src/Admin.php:90
msgid "You do not have permission to change these settings."
msgstr "У вас нет разрешения на изменение этих настроек."

#: src/Admin.php:97
msgid "The settings scope has changed. Open the settings page and try again."
msgstr "Область настроек изменилась. Откройте страницу настроек и попробуйте снова."

#: src/Admin.php:141
msgid "You do not have permission to view these settings."
msgstr "У вас нет разрешения на просмотр этих настроек."

#: src/Admin.php:153
msgid "Network settings"
msgstr "Сетевые настройки"

#: src/Admin.php:153
msgid "Site settings"
msgstr "Настройки сайта"

#: src/Admin.php:154
#: src/Admin.php:177
msgid "LDAP login settings"
msgstr "Настройки входа через LDAP"

#: src/Admin.php:155
msgid "Connect to LDAP, then test a login before enabling authentication."
msgstr ""
"Подключитесь к LDAP, затем протестируйте вход перед включением "
"аутентификации."

#: src/Admin.php:160
msgid "LDAP login and SSO are disabled by SLL_DISABLE_LDAP in wp-config.php."
msgstr "Вход через LDAP и SSO отключены из-за SLL_DISABLE_LDAP в wp-config.php."

#: src/Admin.php:163
msgid ""
"Your saved settings use SSO or custom user fields. Install Simple LDAP "
"Login Pro to use these features. Your settings are kept."
msgstr ""
"Ваши сохраненные настройки используют SSO или пользовательские поля. "
"Установите Simple LDAP Login Pro, чтобы использовать эти функции. Ваши "
"настройки сохранены."

#: src/Admin.php:169
msgid ""
"The saved LDAP search password cannot be read. Enter it again on the "
"Connection tab."
msgstr ""
"Сохраненный пароль поиска LDAP не может быть прочитан. Введите его снова на "
"вкладке Подключение."

#: src/Admin.php:172
msgid "PHP LDAP is missing. Ask your host to install it before enabling LDAP login."
msgstr ""
"PHP LDAP отсутствует. Попросите вашего хостинг-провайдера установить его "
"перед включением LDAP входа."

#: src/Admin.php:175
msgid ""
"LDAP passwords are sent without encryption. Use StartTLS or LDAPS if your "
"server supports it."
msgstr ""
"Пароли LDAP отправляются без шифрования. Используйте StartTLS или LDAPS, "
"если ваш сервер это поддерживает."

#: src/Admin.php:207
msgid "Save settings"
msgstr "Сохранить настройки"

#: src/Admin.php:208
msgid "Settings on other tabs are kept."
msgstr "Настройки на других вкладках сохранены."

#: src/Admin.php:223
msgid "LDAP connection"
msgstr "LDAP соединение"

#: src/Admin.php:224
msgid "LDAP login"
msgstr "LDAP вход"

#: src/Admin.php:224
msgid "Enable LDAP authentication."
msgstr "Включить LDAP аутентификацию."

#: src/Admin.php:227
#: src/Settings.php:597
msgid "Directory type"
msgstr "Тип каталога"

#: src/Admin.php:229
msgid "Active Directory"
msgstr "Active Directory"

#: src/Admin.php:230
msgid "OpenLDAP / other LDAP directory"
msgstr "OpenLDAP / другой LDAP каталог"

#: src/Admin.php:233
#: src/Settings.php:599
msgid "LDAP servers"
msgstr "LDAP серверы"

#: src/Admin.php:233
msgid "One hostname or IP address per line. Servers are tried in order."
msgstr "Один хост или IP-адрес на строку. Серверы пробуются по порядку."

#: src/Admin.php:234
#: src/Settings.php:600
msgid "Base DN"
msgstr "Базовый DN"

#: src/Admin.php:234
msgid "Where to search for users. Example: DC=example,DC=org."
msgstr "Где искать пользователей. Пример: DC=example,DC=org."

#: src/Admin.php:235
#: src/Settings.php:601
msgid "Username suffix"
msgstr "Суффикс имени пользователя"

#: src/Admin.php:235
msgid "Added to usernames without a domain. Example: @example.org."
msgstr "Добавляется к именам пользователей без домена. Пример: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Домашний домен"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr ""
"Короткое имя домена, например EXAMPLE. Имеет приоритет над суффиксом имени "
"пользователя."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
msgid "Connection security"
msgstr "Безопасность соединения"

#: src/Admin.php:238
msgid "TLS requires a trusted server certificate."
msgstr "TLS требует доверенного сертификата сервера."

#: src/Admin.php:243
msgid "StartTLS (recommended)"
msgstr "StartTLS (рекомендуется)"

#: src/Admin.php:244
msgid "LDAPS"
msgstr "LDAPS"

#: src/Admin.php:245
msgid "Unencrypted LDAP"
msgstr "Не зашифрованный LDAP"

#: src/Admin.php:247
msgid "Unencrypted LDAP requires permission on the Advanced tab."
msgstr "Не зашифрованный LDAP требует разрешения на вкладке Расширенные."

#: src/Admin.php:249
#: src/Settings.php:603
msgid "Port"
msgstr "Порт"

#: src/Admin.php:249
msgid "389 for StartTLS; 636 for LDAPS."
msgstr "389 для StartTLS; 636 для LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Искать подпапки"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Искать все организационные единицы ниже базового DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "LDAP учетная запись для поиска"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "LDAP учетная запись с правами чтения пользователей и групп."

#: src/Admin.php:253
msgid "Search account"
msgstr "Учетная запись для поиска"

#: src/Admin.php:253
msgid "LDAP bind DN or account name."
msgstr "LDAP bind DN или имя учетной записи."

#: src/Admin.php:254
#: src/Settings.php:614
msgid "Search account password"
msgstr "Пароль учетной записи для поиска"

#: src/Admin.php:254
msgid "Leave blank to keep the saved password."
msgstr "Оставьте пустым, чтобы сохранить сохраненный пароль."

#: src/Admin.php:262
msgid "Login rules"
msgstr "Правила входа"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Требовать пароли LDAP"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Блокировать пароли WordPress, кроме доступа для восстановления."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Локальный доступ для восстановления"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Выбранные администраторы"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Все супер администраторы (наследие)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Все администраторы (наследие)"

#: src/Admin.php:270
msgid "Off"
msgstr "Выключено"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr ""
"Выберите, кто может использовать пароль WordPress, когда требуются пароли "
"LDAP."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "Автоматическое создание учетных записей"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "Создать учетную запись WordPress при первом успешном входе через LDAP."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "Роль по умолчанию"

#: src/Admin.php:280
msgid "For new accounts only."
msgstr "Только для новых учетных записей."

#: src/Admin.php:281
#: src/Settings.php:609
msgid "Required groups"
msgstr "Обязательные группы"

#: src/Admin.php:281
msgid ""
"One group name per line. Users must belong to at least one. Leave blank to "
"allow all LDAP users."
msgstr ""
"Одно имя группы на строку. Пользователи должны принадлежать хотя бы к "
"одной. Оставьте пустым, чтобы разрешить всем пользователям LDAP."

#: src/Admin.php:295
#: src/Settings.php:613
msgid "Recovery accounts"
msgstr "Учетные записи для восстановления"

#: src/Admin.php:305
msgid ""
"For Selected administrators only. Use separate local accounts with "
"WordPress passwords. Hold Ctrl or Command to select multiple accounts."
msgstr ""
"Только для выбранных администраторов. Используйте отдельные локальные "
"учетные записи с паролями WordPress. Удерживайте Ctrl или Command, чтобы "
"выбрать несколько учетных записей."

#: src/Admin.php:320
msgid "Connection options"
msgstr "Опции соединения"

#: src/Admin.php:320
msgid "Change these only if the default values do not work with your directory."
msgstr ""
"Изменяйте это только в том случае, если значения по умолчанию не работают с "
"вашим каталогом."

#: src/Admin.php:321
msgid "LDAP timeout (seconds)"
msgstr "Таймаут LDAP (секунды)"

#: src/Admin.php:321
msgid "Maximum wait for an LDAP operation. Default: 5 seconds."
msgstr "Максимальное время ожидания для операции LDAP. По умолчанию: 5 секунд."

#: src/Admin.php:322
#: src/Settings.php:606
msgid "Login attribute"
msgstr "Атрибут входа"

#: src/Admin.php:322
msgid "Attribute used to find users. Default: uid."
msgstr "Атрибут, используемый для поиска пользователей. По умолчанию: uid."

#: src/Admin.php:323
msgid "Allow unencrypted LDAP"
msgstr "Разрешить не зашифрованный LDAP"

#: src/Admin.php:323
msgid "Allow passwords to be sent without encryption."
msgstr "Разрешить отправку паролей без шифрования."

#: src/Admin.php:325
msgid "Group search"
msgstr "Поиск группы"

#: src/Admin.php:326
#: src/Settings.php:610
msgid "Group base DN"
msgstr "Базовый DN группы"

#: src/Admin.php:326
msgid "Leave blank to use the user Base DN."
msgstr "Оставьте пустым, чтобы использовать базовый DN пользователя."

#: src/Admin.php:327
#: src/Settings.php:607
msgid "Group name attribute"
msgstr "Атрибут имени группы"

#: src/Admin.php:327
msgid "Default: cn."
msgstr "По умолчанию: cn."

#: src/Admin.php:328
#: src/Settings.php:608
msgid "Group member attribute"
msgstr "Атрибут члена группы"

#: src/Admin.php:328
msgid "Default: memberUid. Use member or uniqueMember if groups store user DNs."
msgstr ""
"По умолчанию: memberUid. Используйте member или uniqueMember, если группы "
"хранят DN пользователей."

#: src/Admin.php:330
msgid "Profile attributes"
msgstr "Атрибуты профиля"

#: src/Admin.php:330
msgid "LDAP attributes copied to new WordPress accounts."
msgstr "Атрибуты LDAP, скопированные в новые учетные записи WordPress."

#: src/Admin.php:331
#: src/Settings.php:618
msgid "First name attribute"
msgstr "Атрибут имени"

#: src/Admin.php:332
#: src/Settings.php:619
msgid "Last name attribute"
msgstr "Атрибут фамилии"

#: src/Admin.php:333
#: src/Settings.php:620
msgid "Email attribute"
msgstr "Атрибут электронной почты"

#: src/Admin.php:334
#: src/Settings.php:621
msgid "Website attribute"
msgstr "Атрибут веб-сайта"

#: src/Admin.php:337
msgid "Data retention"
msgstr "Хранение данных"

#: src/Admin.php:338
msgid "Delete settings when removing the plugin"
msgstr "Удалить настройки при удалении плагина"

#: src/Admin.php:338
msgid ""
"Delete saved settings and LDAP credentials when WordPress deletes the "
"plugin. Keep user accounts."
msgstr ""
"Удалить сохраненные настройки и учетные данные LDAP, когда WordPress "
"удаляет плагин. Сохранить учетные записи пользователей."

#: src/Admin.php:346
#: src/Admin.php:382
msgid "Test LDAP login"
msgstr "Тест LDAP входа"

#: src/Admin.php:346
msgid ""
"Save your settings, then run both tests. Keep this administrator session "
"open."
msgstr ""
"Сохраните свои настройки, затем выполните оба теста. Оставьте эту сессию "
"администратора открытой."

#: src/Admin.php:348
msgid ""
"Tests check the connection, password, and required groups. They do not "
"create accounts or sign users in."
msgstr ""
"Тесты проверяют соединение, пароль и необходимые группы. Они не создают "
"учетные записи и не входят в систему."

#: src/Admin.php:349
msgid "After both tests pass, enable LDAP and try logging in from another browser."
msgstr ""
"После успешного прохождения обоих тестов включите LDAP и попробуйте войти "
"из другого браузера."

#: src/Admin.php:350
msgid "Recovery"
msgstr "Восстановление"

#: src/Admin.php:351
msgid ""
"If you are locked out, rename the simple-ldap-login folder using your "
"hosting file manager. Log in with a WordPress administrator password, then "
"restore the folder and correct the settings."
msgstr ""
"Если вы заблокированы, переименуйте папку simple-ldap-login с помощью "
"файлового менеджера вашего хостинга. Войдите с паролем администратора "
"WordPress, затем восстановите папку и исправьте настройки."

#: src/Admin.php:352
msgid ""
"For certificate errors, ask your host to configure the trusted LDAP "
"certificate authority."
msgstr ""
"Для ошибок сертификата попросите вашего хостера настроить доверенный LDAP "
"центр сертификации."

#: src/Admin.php:366
msgid "LDAP tests"
msgstr "Тесты LDAP"

#: src/Admin.php:367
msgid "Tests use saved settings."
msgstr "Тесты используют сохраненные настройки."

#: src/Admin.php:372
msgid "1. Test connection"
msgstr "1. Тест соединения"

#: src/Admin.php:373
msgid "Connect to LDAP and test the search account, if set."
msgstr ""
"Подключитесь к LDAP и протестируйте учетную запись поиска, если она "
"установлена."

#: src/Admin.php:374
msgid "Test connection"
msgstr "Тест соединения"

#: src/Admin.php:378
msgid "2. Test login"
msgstr "2. Тест входа"

#: src/Admin.php:379
msgid "Check an LDAP username, password, and group membership."
msgstr "Проверьте имя пользователя LDAP, пароль и членство в группе."

#: src/Admin.php:380
msgid "LDAP username"
msgstr "Имя пользователя LDAP"

#: src/Admin.php:381
msgid "LDAP password"
msgstr "Пароль LDAP"

#: src/Admin.php:537
msgid "Settings saved."
msgstr "Настройки сохранены."

#: src/Admin.php:538
msgid "Connection test passed."
msgstr "Тест соединения пройден."

#: src/Admin.php:539
msgid ""
"Cannot connect to LDAP. Check the server, port, TLS certificate, and search "
"account."
msgstr ""
"Не удается подключиться к LDAP. Проверьте сервер, порт, сертификат TLS и "
"учетную запись поиска."

#: src/Admin.php:540
msgid "LDAP login test passed. No account was created."
msgstr "Тест входа LDAP пройден. Учетная запись не была создана."

#: src/Admin.php:541
msgid "LDAP login test failed. Check the username, password, and required groups."
msgstr ""
"Тест входа LDAP не удался. Проверьте имя пользователя, пароль и необходимые "
"группы."

#: src/Admin.php:542
msgid "Could not save settings. Check the values and try again."
msgstr "Не удалось сохранить настройки. Проверьте значения и попробуйте снова."

#: src/Admin.php:586
msgid "Connection"
msgstr "Соединение"

#: src/Admin.php:587
msgid "Access"
msgstr "Доступ"

#: src/Admin.php:588
msgid "Advanced"
msgstr "Дополнительно"

#: src/Admin.php:589
msgid "Troubleshooting"
msgstr "Устранение неполадок"

#: src/Authenticator.php:151
