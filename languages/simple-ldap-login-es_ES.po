msgstr "Añadido a nombres de usuario sin un dominio. Ejemplo: @example.org."

#: src/Admin.php:236
#: src/Settings.php:602
msgid "Windows domain"
msgstr "Dominio de Windows"

#: src/Admin.php:236
msgid "Short domain name, such as EXAMPLE. Takes priority over the username suffix."
msgstr ""
"Nombre de dominio corto, como EXAMPLE. Tiene prioridad sobre el sufijo de "
"nombre de usuario."

#: src/Admin.php:238
#: src/Admin.php:241
#: src/Settings.php:598
