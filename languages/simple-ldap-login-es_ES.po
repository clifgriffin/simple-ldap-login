msgstr "389 para StartTLS; 636 para LDAPS."

#: src/Admin.php:250
msgid "Search subfolders"
msgstr "Buscar subcarpetas"

#: src/Admin.php:250
msgid "Search all organizational units below the Base DN."
msgstr "Buscar todas las unidades organizativas debajo de la Base DN."

#: src/Admin.php:252
msgid "LDAP search account"
msgstr "Cuenta de búsqueda LDAP"

#: src/Admin.php:252
msgid "An LDAP account with read access to users and groups."
msgstr "Una cuenta LDAP con acceso de lectura a usuarios y grupos."

#: src/Admin.php:253
