msgid "Login rules"
msgstr "Reglas de inicio de sesión"

#: src/Admin.php:263
msgid "Require LDAP passwords"
msgstr "Requerir contraseñas LDAP"

#: src/Admin.php:263
msgid "Block WordPress passwords except for recovery access."
msgstr "Bloquear contraseñas de WordPress excepto para acceso de recuperación."

#: src/Admin.php:266
#: src/Settings.php:612
msgid "Local recovery access"
msgstr "Acceso de recuperación local"

#: src/Admin.php:268
msgid "Selected administrators"
msgstr "Administradores seleccionados"

#: src/Admin.php:269
msgid "All super administrators (legacy)"
msgstr "Todos los superadministradores (legado)"

#: src/Admin.php:269
msgid "All administrators (legacy)"
msgstr "Todos los administradores (legado)"

#: src/Admin.php:270
msgid "Off"
msgstr "Desactivado"

#: src/Admin.php:272
msgid "Choose who can use a WordPress password when LDAP passwords are required."
msgstr ""
"Elija quién puede usar una contraseña de WordPress cuando se requieren "
"contraseñas LDAP."

#: src/Admin.php:275
msgid "Automatic account creation"
msgstr "Creación automática de cuentas"

#: src/Admin.php:275
msgid "Create a WordPress account on the first successful LDAP login."
msgstr "Crear una cuenta de WordPress en el primer inicio de sesión LDAP exitoso."

#: src/Admin.php:280
#: src/Settings.php:611
msgid "Default role"
msgstr "Rol predeterminado"

#: src/Admin.php:280
msgid "For new accounts only."
