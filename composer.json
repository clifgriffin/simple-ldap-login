{
    "name": "clifgriffin/simple-ldap-login",
    "description": "WordPress authentication for Active Directory and OpenLDAP.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-ldap": "*",
        "ext-openssl": "*",
        "directorytree/ldaprecord": "^4.1",
        "paidcommunities/wordpress-sdk": "0.0.4"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "SimpleLdapLogin\\": "src/"
        },
        "files": [
            "src/compat.php"
        ],
        "exclude-from-classmap": [
            "/src/compat.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "php tests/run.php",
            "php tests/admin.php",
            "php tests/uninstall.php"
        ],
        "lint": "php -r \"define('ABSPATH', getcwd() . '/'); require 'vendor/bin/phpcs';\" --",
        "format": "php -r \"define('ABSPATH', getcwd() . '/'); require 'vendor/bin/phpcbf';\" --",
        "check": [
            "@test",
            "@lint"
        ],
        "build": "npm run plugin-zip",
        "test:paid": [
            "@test",
            "php tests/run.php paid",
            "php tests/admin.php paid",
            "php pro/tests/upgrades.php",
            "php pro/tests/licenses.php",
            "php pro/tests/licenses.php enterprise"
        ],
        "lint:paid": [
            "@lint",
            "php -r \"define('ABSPATH', getcwd() . '/'); require 'vendor/bin/phpcs';\" -- pro/bootstrap.php pro/src"
        ],
        "check:paid": [
            "@test:paid",
            "@lint:paid"
        ]
    }
}
